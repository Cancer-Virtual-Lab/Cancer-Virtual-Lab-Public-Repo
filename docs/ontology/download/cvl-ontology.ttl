###  http://irst.emr.it/cvl/Service
cvl:Service rdf:type owl:Class ;
            rdfs:label "Clinical Service"@en ,
                       "Prestazione Clinica"@it ;
            skos:definition "A clinical service or procedure (e.g., imaging, surgery, outpatient visit) provided to a patient by a hospital department."@en .


###  http://irst.emr.it/cvl/SexAssignedAtBirth
cvl:SexAssignedAtBirth rdf:type owl:Class ;
                       owl:equivalentClass <https://loinc.org/76689-9> ;
                       rdfs:label "Sesso assegnato alla nascita"@it ,
                                  "Sex assigned at birth"@en ;
                       skos:definition "The sex assigned to a patient at birth (e.g., male, female)."@en .


###  http://irst.emr.it/cvl/SmokerPatient
cvl:SmokerPatient rdf:type owl:Class ;
                  skos:closeMatch <http://snomed.info/sct/77176002> ;
                  rdfs:subClassOf cvl:Patient ;
                  rdfs:label "Paziente fumatore"@it ,
                             "Smoker patient"@en ;
                  skos:definition "A patient who has a recorded physiological history of smoking, tobacco use, or nicotine addiction."@en .


###  http://irst.emr.it/cvl/SymptomAssessment
cvl:SymptomAssessment rdf:type owl:Class ;
                      rdfs:subClassOf fhir:Observation ;
                      rdfs:label "Symptom Assessment"@en ,
                                 "Valutazione dei sintomi"@it ;
                      skos:definition "An Edmonton Symptom Assessment System (ESAS) survey evaluating the patient's palliative symptoms, pain, and quality of life."@en .


###  http://irst.emr.it/cvl/SymptomAssessmentFinding
cvl:SymptomAssessmentFinding rdf:type owl:Class ;
                             rdfs:label "Rilevazione dei sintomi manifestati"@it ,
                                        "Symptom Assessment finding"@en ;
                             skos:definition "A specific subjective symptom reported in an ESAS survey along with its severity score (e.g., Pain=8)."@en .


###  http://irst.emr.it/cvl/TNM
cvl:TNM rdf:type owl:Class ;
        owl:equivalentClass <http://snomed.info/sct/399390009> ;
        rdfs:subClassOf fhir:Observation ;
        rdfs:label "TNM"@en ,
                   "TNM"@it ;
        skos:definition "A general representation of the Tumor, Node, Metastasis (TNM) oncology staging system used to describe the extent of cancer."@en .


###  http://irst.emr.it/cvl/TNMClassification
cvl:TNMClassification rdf:type owl:Class ;
                      owl:equivalentClass <http://snomed.info/sct/399566009> ;
                      rdfs:subClassOf fhir:Observation ;
                      rdfs:label "Classificazione TNM"@it ,
                                 "TNM Classification"@en ;
                      skos:definition "An overarching classification category for any specific T (Tumor), N (Node), or M (Metastasis) staging score."@en .


###  http://irst.emr.it/cvl/TNMClassificationM
cvl:TNMClassificationM rdf:type owl:Class ;
                       owl:equivalentClass <http://snomed.info/sct/277208005> ;
                       rdfs:subClassOf <http://snomed.info/sct/399566009> ;
                       rdfs:label "Categoria M"@it ,
                                  "M category"@en ;
                       skos:definition "The parent class for Metastasis (M) staging categories, indicating distant cancer spread."@en .


###  http://irst.emr.it/cvl/TNMClassificationN
cvl:TNMClassificationN rdf:type owl:Class ;
                       owl:equivalentClass <http://snomed.info/sct/277206009> ;
                       rdfs:subClassOf <http://snomed.info/sct/399566009> ;
                       rdfs:label "Categoria N"@it ,
                                  "N category"@en ;
                       skos:definition "The parent class for Node (N) staging categories, indicating regional lymph node involvement."@en .


###  http://irst.emr.it/cvl/TNMClassificationT
cvl:TNMClassificationT rdf:type owl:Class ;
                       owl:equivalentClass <http://snomed.info/sct/78873005> ;
                       rdfs:subClassOf <http://snomed.info/sct/399566009> ;
                       rdfs:label "Categoria T"@it ,
                                  "T category"@en ;
                       skos:definition "The parent class for Tumor (T) staging categories, indicating primary tumor size and local extent."@en .


###  http://irst.emr.it/cvl/Therapy
cvl:Therapy rdf:type owl:Class ;
            rdfs:label "Terapia"@it ,
                       "Therapy"@en ;
            skos:definition "A treatment plan or oncological regimen (e.g., chemotherapy, immunotherapy, targeted therapy) administered to a patient over a period of time."@en .


###  http://irst.emr.it/cvl/TherapySetting
