@prefix : <http://irst.emr.it/cvl/> .
@prefix cvl: <http://irst.emr.it/cvl/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://irst.emr.it/cvl/> .

<http://irst.emr.it/cvl/> rdf:type owl:Ontology ;
                           owl:versionIRI <http://irst.emr.it/cvl/1.1.0> ;
                           dcterms:bibliographicCitation "Giorgetti L, Carbonaro A, Ridolfi L, Pasolini R, Pagliarani A, Cavallucci M, Andalò A, Del Gaudio L, De Angelis P, Vespignani R, Gentili N. Cancer Virtual Lab Ontology (CVL-O), version 1.1.0. Zenodo; 2026. https://doi.org/10.5281/zenodo.23762955" ;
                           dcterms:created "2025-01-30"^^xsd:date ;
                           dcterms:contributor <https://orcid.org/0000-0002-3890-4852> ,
                                               "Lorenzo Ridolfi" ,
                                               "Roberto Pasolini" ,
                                               <https://orcid.org/0009-0007-4241-3005> ,
                                               "Martina Cavallucci" ,
                                               <https://orcid.org/0009-0005-8022-0242> ,
                                               <https://orcid.org/0009-0000-4148-5954> ,
                                               "Paolo De Angelis" ,
                                               <https://orcid.org/0000-0003-3676-171X> ,
                                               <https://orcid.org/0000-0002-0066-9172> ;
                           dcterms:creator <https://orcid.org/0009-0002-9475-0744> ;
                           dcterms:description "The Cancer Virtual Lab Ontology (CVL-O) is an OWL 2 ontology for representing the oncological care pathway of patients from real-world clinical data: diagnosis and TNM staging, therapies and drug administrations, adverse events, biomarkers, genomic variants, laboratory tests, body measurements, symptom assessments, treatment response and clinical services. It is aligned with HL7 FHIR and reuses standard biomedical terminologies (SNOMED CT, LOINC, NCIt, ICD-10, ATC). CVL-O is the semantic foundation of the Cancer Virtual Lab project, a collaboration between the University of Bologna, IRCCS Istituto Romagnolo per lo Studio dei Tumori (IRST) \"Dino Amadori\", Aivolution Srl and IFAB (International Foundation Big Data and Artificial Intelligence for Human Development), and underpins the Cancer Virtual Lab knowledge graph."@en ;
                           dcterms:isPartOf <https://doi.org/10.5281/zenodo.23762955> ;
                           dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                           dcterms:modified "2026-10-30"^^xsd:date ;
                           dcterms:title "Cancer Virtual Lab Ontology (CVL-O)"@en ;
                           vann:preferredNamespacePrefix "cvl" ;
                           vann:preferredNamespaceUri "http://irst.emr.it/cvl/" ;
                           rdfs:comment "The clinical definitions (skos:definition) of CVL-O 1.1.0 have been reviewed and validated by the biomedical team of the Cancer Virtual Lab project."@en ;
                           rdfs:seeAlso <https://cancer-virtual-lab.github.io/Cancer-Virtual-Lab-Public-Repo/> ,
                                        <https://github.com/Cancer-Virtual-Lab/Cancer-Virtual-Lab-Public-Repo> ;
                           owl:versionInfo "1.1.0" .

