cvl:category3 rdf:type owl:DatatypeProperty ;
              rdfs:domain cvl:Service ;
              rdfs:range xsd:string ;
              rdfs:label "Categoria 3 della prestazione"@it ,
                         "Category 3"@en ;
              skos:definition "Tertiary hierarchical classification category for a clinical service or procedure."@en .


###  http://irst.emr.it/cvl/currency
cvl:currency rdf:type owl:DatatypeProperty ;
             rdfs:domain cvl:Service ;
             rdfs:range xsd:string ;
             rdfs:label "Currency"@en ,
