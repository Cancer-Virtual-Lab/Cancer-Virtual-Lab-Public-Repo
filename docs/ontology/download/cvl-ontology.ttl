                        rdfs:label "Maximum reference value"@en ,
                                   "Valore massimo di riferimento"@it ;
                        skos:definition "The upper limit of the normal reference range for a laboratory test."@en .


###  http://irst.emr.it/cvl/reference_min_unit
cvl:reference_min_unit rdf:type owl:DatatypeProperty ;
                       rdfs:domain cvl:LaboratoryTest ;
                       rdfs:range xsd:string ;
                       rdfs:label "Minimum reference unit"@en ,
                                  "Unità del valore minimo di riferimento"@it ;
                       skos:definition "The unit of measurement for a lab test's minimum normal value."@en .


###  http://irst.emr.it/cvl/reference_min_value
cvl:reference_min_value rdf:type owl:DatatypeProperty ;
                        rdfs:domain cvl:LaboratoryTest ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "Minimum reference value"@en ,
                                   "Valore minimo di riferimento"@it ;
                        skos:definition "The lower limit of the normal reference range for a laboratory test."@en .


###  http://irst.emr.it/cvl/response_date
cvl:response_date rdf:type owl:DatatypeProperty ;
                  rdfs:domain cvl:Response ;
                  rdfs:range xsd:date ;
                  rdfs:label "Data della risposta"@it ,
                             "Response date"@en ;
                  skos:definition "The date a clinical response evaluation or tumor restaging was recorded."@en .


###  http://irst.emr.it/cvl/response_description
cvl:response_description rdf:type owl:DatatypeProperty ;
                         rdfs:domain cvl:Response ;
                         rdfs:range xsd:string ;
                         rdfs:label "Descrizione della risposta"@it ,
                                    "Response description"@en ;
                         skos:definition "Free-text description of a clinical response assessment as reported in the source record."@en .


###  http://irst.emr.it/cvl/response_value
cvl:response_value rdf:type owl:DatatypeProperty ;
                   rdfs:domain cvl:Response ;
                   rdfs:range xsd:string ;
                   rdfs:label "Response value"@en ,
                              "Valore della risposta"@it ;
                   skos:definition "The clinical outcome or tumor response to therapy (e.g., 'Complete Response', 'Progressive Disease', 'Stable Disease')."@en .


###  http://irst.emr.it/cvl/service_date
cvl:service_date rdf:type owl:DatatypeProperty ;
                 rdfs:domain cvl:Service ;
                 rdfs:range xsd:date ;
                 rdfs:label "Data di erogazione della prestazione"@it ,
                            "Service date"@en ;
                 skos:definition "The date a clinical service, imaging scan, or procedure was provided."@en .


###  http://irst.emr.it/cvl/service_description
cvl:service_description rdf:type owl:DatatypeProperty ;
                        rdfs:domain cvl:Service ;
                        rdfs:range xsd:string ;
                        rdfs:label "Descrizione della prestazione"@it ,
                                   "Service description"@en ;
                        skos:definition "The text description of a medical procedure, imaging scan, surgery, or clinical service."@en .


###  http://irst.emr.it/cvl/site_description
cvl:site_description rdf:type owl:DatatypeProperty ;
                     rdfs:domain cvl:Diagnosis ;
                     rdfs:range xsd:string ;
                     rdfs:label "Descrizione della sede anamnestica"@it ,
                                "Site description"@en ;
                     skos:definition "The anatomical site, organ, or bodily location where the primary tumor or cancer is located (e.g., 'Lung', 'Breast', 'Colon')."@en .


###  http://irst.emr.it/cvl/smoking
cvl:smoking rdf:type owl:DatatypeProperty ;
            rdfs:domain cvl:PhysiologicalHistory ;
            rdfs:range xsd:boolean ;
            rdfs:label "Fumo"@it ,
                       "Smoking"@en ;
            skos:definition "Boolean flag (true/false) indicating whether the patient is a smoker or uses tobacco."@en .


###  http://irst.emr.it/cvl/stage_description
cvl:stage_description rdf:type owl:DatatypeProperty ;
                      rdfs:domain cvl:Diagnosis ;
                      rdfs:range xsd:string ;
                      rdfs:label "Descrizione dello stadio della malattia"@it ,
                                 "Disease stage description"@en ;
                      skos:definition "The overall clinical or pathological stage of the cancer (e.g., 'Stage IIIA', 'Stage IV', 'Metastatic')."@en .


###  http://irst.emr.it/cvl/symptom_assessment_value
cvl:symptom_assessment_value rdf:type owl:DatatypeProperty ;
                             rdfs:domain cvl:SymptomAssessmentFinding ;
                             rdfs:range xsd:integer ;
                             rdfs:label "Symptom assessment value"@en ,
                                        "Valore valutazione dei sintomi"@it ;
                             skos:definition "The numeric severity score (usually 0-10) for a specific patient-reported symptom (pain, fatigue, nausea, etc.)."@en .


###  http://irst.emr.it/cvl/target_description
cvl:target_description rdf:type owl:DatatypeProperty ;
                       rdfs:domain cvl:ECOGStatus ;
                       rdfs:range xsd:string ;
                       rdfs:label "Descrizione del target"@it ,
                                  "Target description"@en ;
                       skos:definition "The text description of the patient's ECOG performance status (e.g., 'Fully active', 'Restricted in physically strenuous activity')."@en .


###  http://irst.emr.it/cvl/toxicity_grade_description
cvl:toxicity_grade_description rdf:type owl:DatatypeProperty ;
                               rdfs:domain cvl:AdverseEventEffect ;
                               rdfs:range xsd:string ;
                               rdfs:label "Descrizione del grado di tossicità"@it ,
                                          "Toxicity grade description"@en ;
                               skos:definition "Text description of the severity of an adverse event or side effect."@en .


###  http://irst.emr.it/cvl/toxicity_grade_value
cvl:toxicity_grade_value rdf:type owl:DatatypeProperty ;
                         rdfs:domain cvl:AdverseEventEffect ;
                         rdfs:range xsd:integer ;
                         rdfs:label "Toxicity grade value"@en ,
                                    "Valore del grado di tossicità"@it ;
                         skos:definition "Numeric grade (usually 1-5) indicating the severity of an adverse event or clinical toxicity."@en .


###  http://irst.emr.it/cvl/variant2
cvl:variant2 rdf:type owl:DatatypeProperty ;
             rdfs:domain cvl:Variant ;
             rdfs:range xsd:string ;
             rdfs:label "Seconda variante"@it ,
                        "Variant 2"@en ;
             skos:definition "Additional molecular information or secondary classification about a genetic variant."@en ;
             skos:exactMatch <http://snomed.info/sct/64195000> .


###  http://irst.emr.it/cvl/variant_date
cvl:variant_date rdf:type owl:DatatypeProperty ;
                 rdfs:domain cvl:Variant ;
                 rdfs:range xsd:date ;
                 rdfs:label "Data della variante"@it ,
                            "Variant date"@en ;
                 skos:definition "The date a genetic variant or mutation was sequenced or detected."@en .


###  http://irst.emr.it/cvl/variant_description
cvl:variant_description rdf:type owl:DatatypeProperty ;
                        rdfs:domain cvl:Variant ;
                        rdfs:range xsd:string ;
                        rdfs:label "Descrizione della variante"@it ,
                                   "Variant description"@en ;
                        skos:definition "The name or gene of the detected mutation, variant, or genetic alteration (e.g., 'EGFR', 'BRAF', 'KRAS')."@en .



#################################################################
#    Classes
#################################################################

###  http://hl7.org/fhir/AdverseEvent
fhir:AdverseEvent rdf:type owl:Class ;
                  owl:equivalentClass cvl:AdverseEvent ;
                  rdfs:label "fhir:AdverseEvent" .


###  http://hl7.org/fhir/CarePlan
fhir:CarePlan rdf:type owl:Class ;
              owl:equivalentClass cvl:Therapy ;
              rdfs:label "fhir:CarePlan" .


###  http://hl7.org/fhir/ChargeItem
fhir:ChargeItem rdf:type owl:Class ;
                owl:equivalentClass cvl:Service ;
                rdfs:label "fhir:ChargeItem" .


###  http://hl7.org/fhir/Condition
fhir:Condition rdf:type owl:Class ;
               rdfs:label "fhir:Condition" .


###  http://hl7.org/fhir/Medication
fhir:Medication rdf:type owl:Class ;
                owl:equivalentClass cvl:ActiveSubstance ;
                rdfs:label "fhir:Medication" .


###  http://hl7.org/fhir/MedicationAdministration
fhir:MedicationAdministration rdf:type owl:Class ;
                              owl:equivalentClass cvl:Administration ;
                              rdfs:label "fhir:MedicationAdministration" .


###  http://hl7.org/fhir/Observation
fhir:Observation rdf:type owl:Class ;
                 rdfs:label "fhir:Observation" .


###  http://hl7.org/fhir/Organization
fhir:Organization rdf:type owl:Class ;
                  owl:equivalentClass cvl:Department ;
                  rdfs:label "fhir:Organization" .


###  http://hl7.org/fhir/Patient
fhir:Patient rdf:type owl:Class ;
             owl:equivalentClass cvl:Patient ;
             rdfs:label "fhir:Patient" .


###  http://irst.emr.it/cvl/ActiveSubstance
cvl:ActiveSubstance rdf:type owl:Class ;
                    rdfs:label "Active Substance"@en ,
                               "Principio Attivo"@it ;
                    skos:definition "The pharmacologically active ingredient of a medication administered to a patient, identified by its ATC code (e.g., cisplatin, pembrolizumab)."@en .


###  http://irst.emr.it/cvl/AdjuvantTherapy
cvl:AdjuvantTherapy rdf:type owl:Class ;
                    owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15675> ;
                    rdfs:subClassOf cvl:TherapySetting ;
                    skos:definition "A therapy setting given after the primary treatment (like surgery) to lower the risk that the cancer will return."@en .


###  http://irst.emr.it/cvl/Administration
cvl:Administration rdf:type owl:Class ;
                   rdfs:label "Administration"@en ,
                              "Somministrazione"@it ;
                   skos:definition "A specific event where a drug, medication, or therapy dose is physically given to the patient at a specific time and date."@en .


###  http://irst.emr.it/cvl/AdvancedTherapy
cvl:AdvancedTherapy rdf:type owl:Class ;
                    rdfs:subClassOf cvl:TherapySetting ;
                    skos:definition "A therapy setting for treating advanced, late-stage, or metastatic cancer that has spread."@en .


###  http://irst.emr.it/cvl/AdverseEvent
cvl:AdverseEvent rdf:type owl:Class ;
                 rdfs:label "Adverse Event"@en ,
                            "Evento avverso"@it ;
                 skos:definition "An unfavourable and unintended medical occurrence experienced by a patient following a treatment administration, whether or not considered related to it."@en .


###  http://irst.emr.it/cvl/AdverseEventEffect
cvl:AdverseEventEffect rdf:type owl:Class ;
                       rdfs:subClassOf fhir:Condition ;
                       rdfs:label "Adverse Event Effect"@en ,
                                  "Effetto evento avverso"@it ;
                       skos:definition "The specific type and severity (toxicity grade) of a side effect experienced by the patient (e.g., severe nausea, grade 3 rash)."@en .


###  http://irst.emr.it/cvl/Anxiety
cvl:Anxiety rdf:type owl:Class ;
            skos:closeMatch <http://snomed.info/sct/48694002> ;
            rdfs:subClassOf cvl:SymptomAssessmentFinding ;
            rdfs:label "Ansia"@it ,
                       "Anxiety"@en ;
            skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's anxiety, nervousness or psychological distress on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Biomarker
cvl:Biomarker rdf:type owl:Class ;
              rdfs:subClassOf fhir:Observation ;
              rdfs:label "Biomarker"@en ,
                         "Biomarker"@it ;
              skos:definition "A measurable biological, molecular, or genetic marker tested in the patient's tumor or blood used to guide targeted therapy (e.g., PD-L1, EGFR, HER2)."@en .


###  http://irst.emr.it/cvl/BodyMeasurement
cvl:BodyMeasurement rdf:type owl:Class ;
                    rdfs:subClassOf fhir:Observation ;
                    rdfs:label "Body Measurement"@en ,
                               "Peso e Altezza"@it ;
                    skos:definition "A record of a patient's physical body metrics (e.g., height, weight) taken on a given date."@en .


###  http://irst.emr.it/cvl/BodyMetric
cvl:BodyMetric rdf:type owl:Class ;
               rdfs:label "Body Metric"@en ,
                          "Metrica corporea"@it ;
               skos:definition "A specific physical measurement value, such as a patient's exact height in centimeters or weight in kilograms."@en .


###  http://irst.emr.it/cvl/BreathingDifficulty
cvl:BreathingDifficulty rdf:type owl:Class ;
                        skos:closeMatch <http://snomed.info/sct/267036007> ;
                        rdfs:subClassOf cvl:SymptomAssessmentFinding ;
                        rdfs:label "Breathing difficulty"@en ,
                                   "Difficoltà a respirare"@it ;
                        skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's shortness of breath, dyspnea or trouble breathing on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/C_M_Class
cvl:C_M_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/399387003> ;
              rdfs:subClassOf cvl:TNMClassificationM ;
              rdfs:label "Clinical presence of distant metastasis (M)"@en ,
                         "Presenza clinica di metastasi a distanza (M)"@it ;
              skos:definition "Clinical Metastasis (cM) category in TNM staging, indicating the presence or absence of distant spread based on clinical imaging before surgery."@en .


###  http://irst.emr.it/cvl/C_N_Class
cvl:C_N_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/399534004> ;
              rdfs:subClassOf cvl:TNMClassificationN ;
              rdfs:label "Clinical spread to regional lymph nodes (N)"@en ,
                         "Coinvolgimento clinico dei linfonodi regionali (N)"@it ;
              skos:definition "Clinical Node (cN) category in TNM staging, indicating regional lymph node involvement based on clinical exams before surgery."@en .


###  http://irst.emr.it/cvl/C_T_Class
cvl:C_T_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/399504009> ;
              rdfs:subClassOf cvl:TNMClassificationT ;
              rdfs:label "Clinical tumor size (T)"@en ,
                         "Dimensione del tumore clinica (T)"@it ;
              skos:definition "Clinical Tumor (cT) category in TNM staging, indicating the size and extent of the primary tumor based on clinical exams before surgery."@en .


###  http://irst.emr.it/cvl/ClinicalTNM
cvl:ClinicalTNM rdf:type owl:Class ;
                owl:equivalentClass <http://snomed.info/sct/399537006> ;
                rdfs:subClassOf cvl:TNM ;
                rdfs:label "Clinical TNM"@en ,
                           "TNM clinico"@it ;
                skos:definition "The clinical TNM (Tumor, Node, Metastasis) staging classification, assessed before definitive surgery using imaging and biopsies."@en .


###  http://irst.emr.it/cvl/ConcomitantWithRadiotherapy
cvl:ConcomitantWithRadiotherapy rdf:type owl:Class ;
                                owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94626> ;
                                rdfs:subClassOf cvl:TherapySetting ;
                                skos:definition "A therapy setting where systemic treatment (like chemotherapy) is administered concurrently or at the same time as radiation therapy."@en .


###  http://irst.emr.it/cvl/ConsolidationTherapy
cvl:ConsolidationTherapy rdf:type owl:Class ;
                         owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15679> ;
                         rdfs:subClassOf cvl:TherapySetting ;
                         skos:definition "A therapy setting given to kill any cancer cells that may be left after initial treatment to deepen the patient's response."@en .


###  http://irst.emr.it/cvl/Department
cvl:Department rdf:type owl:Class ;
               rdfs:label "Department"@en ,
                          "Reparto"@it ;
               skos:definition "A specific hospital unit, clinic, or medical department that provides clinical services or procedures."@en .


###  http://irst.emr.it/cvl/Depression
cvl:Depression rdf:type owl:Class ;
               skos:closeMatch <http://snomed.info/sct/35489007> ;
               rdfs:subClassOf cvl:SymptomAssessmentFinding ;
               rdfs:label "Depression"@en ,
                          "Depressione"@it ;
               skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's depression, sadness or low mood on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Diagnosis
cvl:Diagnosis rdf:type owl:Class ;
              rdfs:subClassOf fhir:Condition ;
              rdfs:label "Diagnosi"@it ,
                         "Diagnosis"@en ;
              skos:definition "The formal medical identification of the patient's cancer, tumor, or disease, including its anatomical primary site and overall stage."@en .


###  http://irst.emr.it/cvl/DrinkerPatient
cvl:DrinkerPatient rdf:type owl:Class ;
                   skos:closeMatch <http://snomed.info/sct/219006> ;
                   rdfs:subClassOf cvl:Patient ;
                   rdfs:label "Drinker patient"@en ,
                              "Paziente consumatore di alcolici"@it ;
                   skos:definition "A patient who has a recorded physiological history of consuming alcohol or being a drinker."@en .


###  http://irst.emr.it/cvl/Drowsiness
cvl:Drowsiness rdf:type owl:Class ;
               skos:closeMatch <http://snomed.info/sct/271782001> ;
               rdfs:subClassOf cvl:SymptomAssessmentFinding ;
               rdfs:label "Drowsiness"@en ,
                          "Sonnolenza"@it ;
               skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's unusual sleepiness or drowsiness on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding
cvl:ECOGPerformanceStatusFinding rdf:type owl:Class ;
                                 owl:equivalentClass <http://snomed.info/sct/424122007> ;
                                 rdfs:label "ECOG performance status finding"@en ,
                                            "Valore ECOG performance status"@it ;
                                 skos:definition "The specific numeric grade (0 through 5) assigned during an ECOG performance status assessment."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding0
cvl:ECOGPerformanceStatusFinding0 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/425389002> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 0, indicating the patient is fully active and able to carry on all pre-disease performance without restriction."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding1
cvl:ECOGPerformanceStatusFinding1 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/422512005> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 1, indicating the patient is restricted in physically strenuous activity but ambulatory."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding2
cvl:ECOGPerformanceStatusFinding2 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/422894000> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 2, indicating the patient is ambulatory and capable of all selfcare but unable to carry out any work activities."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding3
cvl:ECOGPerformanceStatusFinding3 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/423053003> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 3, indicating the patient is capable of only limited selfcare, confined to bed or chair more than 50% of waking hours."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding4
cvl:ECOGPerformanceStatusFinding4 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/423237006> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 4, indicating the patient is completely disabled, cannot carry on any selfcare, and is totally confined to bed or chair."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding5
cvl:ECOGPerformanceStatusFinding5 rdf:type owl:Class ;
                                  owl:equivalentClass <http://snomed.info/sct/423409001> ;
                                  rdfs:subClassOf cvl:ECOGPerformanceStatusFinding ;
                                  skos:definition "ECOG Grade 5, indicating the patient is dead."@en .


###  http://irst.emr.it/cvl/ECOGStatus
cvl:ECOGStatus rdf:type owl:Class ;
               rdfs:subClassOf fhir:Observation ;
               rdfs:label "ECOG Performance Status"@en ,
                          "Stato di performance ECOG"@it ;
               skos:definition "An assessment of a patient's performance status — their level of functioning in terms of self-care, daily activity and physical ability — graded on the Eastern Cooperative Oncology Group (ECOG) scale (0–5)."@en .


###  http://irst.emr.it/cvl/Fatigue
cvl:Fatigue rdf:type owl:Class ;
            skos:closeMatch <http://snomed.info/sct/84229001> ;
            rdfs:subClassOf cvl:SymptomAssessmentFinding ;
            rdfs:label "Fatigue"@en ,
                       "Stanchezza"@it ;
            skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's tiredness, exhaustion or fatigue on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Female
cvl:Female rdf:type owl:Class ;
           owl:equivalentClass <https://loinc.org/LA3-6> ;
           rdfs:subClassOf cvl:SexAssignedAtBirth ;
           skos:definition "Female sex assigned at birth."@en .


###  http://irst.emr.it/cvl/Height
cvl:Height rdf:type owl:Class ;
           owl:equivalentClass <http://snomed.info/sct/50373000> ;
           rdfs:subClassOf cvl:BodyMetric ;
           rdfs:label "Altezza"@it ,
                      "Height"@en ;
           skos:definition "A specific body metric recording how tall the patient is, usually measured in centimeters."@en .


###  http://irst.emr.it/cvl/InductionTherapy
cvl:InductionTherapy rdf:type owl:Class ;
                     owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C158876> ;
                     rdfs:subClassOf cvl:TherapySetting ;
                     skos:definition "Initial or first-phase therapy setting given to shrink a tumor before other treatments like surgery or radiation."@en .


###  http://irst.emr.it/cvl/LaboratoryTest
cvl:LaboratoryTest rdf:type owl:Class ;
                   rdfs:subClassOf fhir:Observation ;
                   rdfs:label "Esame di laboratorio"@it ,
                              "Laboratory Test"@en ;
                   skos:definition "A laboratory test performed on a patient specimen, reported with its normal reference range."@en .


###  http://irst.emr.it/cvl/LineOfTherapy
cvl:LineOfTherapy rdf:type owl:Class ;
                  rdfs:label "Line of therapy"@en ,
                             "Linea di terapia"@it ;
                  skos:definition "Represents the sequential order of cancer treatments a patient receives over time."@en .


###  http://irst.emr.it/cvl/LineOfTherapy1
cvl:LineOfTherapy1 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45792> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "First-line therapy, the initial treatment regimen given for a disease."@en .


###  http://irst.emr.it/cvl/LineOfTherapy10
cvl:LineOfTherapy10 rdf:type owl:Class ;
                    rdfs:subClassOf cvl:LineOfTherapy ;
                    skos:definition "Tenth-line therapy, a highly advanced subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy2
cvl:LineOfTherapy2 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C54350> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Second-line therapy, the treatment given when the first-line therapy doesn't work or stops working."@en .


###  http://irst.emr.it/cvl/LineOfTherapy3
cvl:LineOfTherapy3 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94628> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Third-line therapy, given after first- and second-line treatments have failed."@en .


###  http://irst.emr.it/cvl/LineOfTherapy4
cvl:LineOfTherapy4 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C133522> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Fourth-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy5
cvl:LineOfTherapy5 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C133524> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Fifth-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy6
cvl:LineOfTherapy6 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C133526> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Sixth-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy7
cvl:LineOfTherapy7 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C133528> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Seventh-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy8
cvl:LineOfTherapy8 rdf:type owl:Class ;
                   owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C133529> ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Eighth-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LineOfTherapy9
cvl:LineOfTherapy9 rdf:type owl:Class ;
                   rdfs:subClassOf cvl:LineOfTherapy ;
                   skos:definition "Ninth-line therapy, a subsequent treatment regimen."@en .


###  http://irst.emr.it/cvl/LossOfAppetite
cvl:LossOfAppetite rdf:type owl:Class ;
                   skos:closeMatch <http://snomed.info/sct/289162002> ;
                   rdfs:subClassOf cvl:SymptomAssessmentFinding ;
                   rdfs:label "Loss of appetite"@en ,
                              "Mancanza di appetito"@it ;
                   skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's loss of appetite or reduced desire to eat on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/MaintenanceTherapy
cvl:MaintenanceTherapy rdf:type owl:Class ;
                       owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15688> ;
                       rdfs:subClassOf cvl:TherapySetting ;
                       skos:definition "A therapy setting intended to help keep cancer from growing after it has shrunk following initial treatment."@en .


###  http://irst.emr.it/cvl/Malaise
cvl:Malaise rdf:type owl:Class ;
            skos:closeMatch <http://snomed.info/sct/367391008> ;
            rdfs:subClassOf cvl:SymptomAssessmentFinding ;
            rdfs:label "Malaise"@en ,
                       "Malessere"@it ;
            skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's general feeling of discomfort, illness or unease (lack of wellbeing) on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Male
cvl:Male rdf:type owl:Class ;
         owl:equivalentClass <https://loinc.org/LA2-8> ;
         rdfs:subClassOf cvl:SexAssignedAtBirth ;
         skos:definition "Male sex assigned at birth."@en .


###  http://irst.emr.it/cvl/Nausea
cvl:Nausea rdf:type owl:Class ;
           skos:closeMatch <http://snomed.info/sct/422587007> ;
           rdfs:subClassOf cvl:SymptomAssessmentFinding ;
           rdfs:label "Nausea"@en ,
                      "Nausea"@it ;
           skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's nausea or urge to vomit on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/NeoadjuvantTherapy
cvl:NeoadjuvantTherapy rdf:type owl:Class ;
                       owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15665> ;
                       rdfs:subClassOf cvl:TherapySetting ;
                       skos:definition "A therapy setting given before the main treatment (usually surgery) to shrink a tumor and make it easier to remove."@en .


###  http://irst.emr.it/cvl/P_M_Class
cvl:P_M_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/371497001> ;
              rdfs:subClassOf cvl:TNMClassificationM ;
              rdfs:label "Pathological presence of distant metastasis (M)"@en ,
                         "Presenza patologica di metastasi a distanza (M)"@it ;
              skos:definition "Pathological Metastasis (pM) category, determining distant spread after examining surgical tissue under a microscope."@en .


###  http://irst.emr.it/cvl/P_N_Class
cvl:P_N_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/371494008> ;
              rdfs:subClassOf cvl:TNMClassificationN ;
              rdfs:label "Coinvolgimento patologico dei linfonodi regionali (N)"@it ,
                         "Pathological spread to regional lymph nodes (N)"@en ;
              skos:definition "Pathological Node (pN) category, indicating lymph node spread based on definitive surgical pathology."@en .


###  http://irst.emr.it/cvl/P_T_Class
cvl:P_T_Class rdf:type owl:Class ;
              owl:equivalentClass <http://snomed.info/sct/384625004> ;
              rdfs:subClassOf cvl:TNMClassificationT ;
              rdfs:label "Dimensione del tumore patologica (T)"@it ,
                         "Pathological tumor size (T)"@en ;
              skos:definition "Pathological Tumor (pT) category, indicating primary tumor extent and size based on definitive surgical pathology."@en .


###  http://irst.emr.it/cvl/Pain
cvl:Pain rdf:type owl:Class ;
         skos:closeMatch <http://snomed.info/sct/22253000> ;
         rdfs:subClassOf cvl:SymptomAssessmentFinding ;
         rdfs:label "Dolore"@it ,
                    "Pain"@en ;
         skos:definition "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's physical pain on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/PathologicalTNM
cvl:PathologicalTNM rdf:type owl:Class ;
                    owl:equivalentClass <http://snomed.info/sct/399588009> ;
                    rdfs:subClassOf cvl:TNM ;
                    rdfs:label "Pathological TNM"@en ,
                               "TNM patologico"@it ;
                    skos:definition "The pathological TNM staging classification, which is the most accurate staging determined after surgical removal and lab examination of the tumor."@en .


###  http://irst.emr.it/cvl/Patient
cvl:Patient rdf:type owl:Class ;
            rdfs:label "Patient"@en ,
                       "Paziente"@it ;
            skos:definition "The core individual person receiving clinical care, diagnosed with cancer, and undergoing oncological therapies."@en .


###  http://irst.emr.it/cvl/PhysiologicalHistory
cvl:PhysiologicalHistory rdf:type owl:Class ;
                         rdfs:subClassOf fhir:Observation ;
                         rdfs:label "Anamnesi Fisiologica"@it ,
                                    "Physiological History"@en ;
                         skos:definition "The patient's lifestyle habits, physiological background, and personal history, notably including smoking and alcohol use."@en .


###  http://irst.emr.it/cvl/Response
cvl:Response rdf:type owl:Class ;
             rdfs:subClassOf fhir:Observation ;
             rdfs:label "Response"@en ,
                        "Risposta al trattamento"@it ;
             skos:definition "The clinical outcome, treatment effect, or restaging result measuring how well the tumor responded to therapy (e.g., progressive disease, stable disease, complete response)."@en .


