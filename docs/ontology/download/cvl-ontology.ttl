                    skos:definition "Alphanumeric identifier code for a hospital department."@en .


###  http://irst.emr.it/cvl/department_name
cvl:department_name rdf:type owl:DatatypeProperty ;
                    rdfs:domain cvl:Department ;
                    rdfs:range xsd:string ;
                    rdfs:label "Department name"@en ,
