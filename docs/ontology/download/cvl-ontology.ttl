                      rdfs:domain cvl:BodyMetric ;
                      rdfs:range xsd:integer ;
                      rdfs:label "Body metric value"@en ,
                                 "Valore metrica"@it ;
                      skos:definition "The numeric integer value of a body measurement (e.g., height in cm, weight in kg)."@en .


