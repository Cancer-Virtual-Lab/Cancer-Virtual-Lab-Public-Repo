#################################################################
#    Data properties
#################################################################

###  http://irst.emr.it/cvl/ECOG_date
cvl:ECOG_date rdf:type owl:DatatypeProperty ;
              rdfs:domain cvl:ECOGStatus ;
              rdfs:range xsd:date ;
              rdfs:label "Data valutazione ECOG"@it ,
                         "ECOG assessment date"@en ;
              skos:definition "The date an ECOG performance status was measured or recorded."@en .


###  http://irst.emr.it/cvl/ESAS_date
cvl:ESAS_date rdf:type owl:DatatypeProperty ;
              rdfs:domain cvl:SymptomAssessment ;
              rdfs:range xsd:dateTime ;
              rdfs:label "Data della valutazione ESAS"@it ,
                         "ESAS assessment date"@en ;
              skos:definition "The date and time a symptom assessment (ESAS) was completed by the patient."@en .


###  http://irst.emr.it/cvl/TNM_value
cvl:TNM_value rdf:type owl:DatatypeProperty ;
              rdfs:domain cvl:TNMClassification ;
              rdfs:range xsd:string ;
              rdfs:label "TNM value"@en ,
                         "Valore della classificazione TNM"@it ;
              skos:definition "The string value representing a TNM classification score (e.g., 'T2', 'N1', 'M0')."@en .


###  http://irst.emr.it/cvl/active_substance_description
cvl:active_substance_description rdf:type owl:DatatypeProperty ;
                                 rdfs:domain cvl:ActiveSubstance ;
                                 rdfs:range xsd:string ;
                                 rdfs:label "Active substance description"@en ,
                                            "Descrizione del principio attivo"@it ;
                                 skos:definition "The name or textual description of a drug, medication, or active substance (e.g., 'Cisplatin', 'Pembrolizumab')."@en .


###  http://irst.emr.it/cvl/administration_date
cvl:administration_date rdf:type owl:DatatypeProperty ;
                        rdfs:domain cvl:Administration ;
                        rdfs:range xsd:date ;
                        rdfs:label "Administration date"@en ,
                                   "Data di somministrazione"@it ;
                        skos:definition "The specific date a drug, medication, or therapy was physically administered to the patient."@en .


###  http://irst.emr.it/cvl/adverse_event_date
cvl:adverse_event_date rdf:type owl:DatatypeProperty ;
                       rdfs:domain cvl:AdverseEvent ;
                       rdfs:range xsd:date ;
                       rdfs:label "Adverse event date"@en ,
                                  "Data dell’evento avverso"@it ;
                       skos:definition "The date an adverse event, toxicity, or side effect began."@en .


###  http://irst.emr.it/cvl/adverse_event_description
cvl:adverse_event_description rdf:type owl:DatatypeProperty ;
                              rdfs:domain cvl:AdverseEventEffect ;
                              rdfs:range xsd:string ;
                              rdfs:label "Adverse event description"@en ,
                                         "Descrizione dell'evento avverso"@it ;
                              skos:definition "The text description of a side effect or adverse event (e.g., 'Nausea', 'Neutropenia', 'Rash')."@en .


###  http://irst.emr.it/cvl/alcohol_consumption
cvl:alcohol_consumption rdf:type owl:DatatypeProperty ;
                        rdfs:domain cvl:PhysiologicalHistory ;
                        rdfs:range xsd:boolean ;
                        rdfs:label "Alcohol consumption"@en ,
                                   "Consumo di alcol"@it ;
                        skos:definition "Boolean flag (true/false) indicating whether the patient consumes alcohol (is a drinker)."@en .


###  http://irst.emr.it/cvl/amino_acid_change
cvl:amino_acid_change rdf:type owl:DatatypeProperty ;
                      rdfs:domain cvl:Variant ;
                      rdfs:range xsd:string ;
                      rdfs:label "Amino acid change"@en ,
                                 "Cambiamento aminoacidico"@it ;
                      skos:definition "The specific protein or amino acid change caused by a genetic variant (e.g., 'V600E', 'L858R')."@en ;
                      skos:exactMatch <http://snomed.info/sct/250574005> .


###  http://irst.emr.it/cvl/birth_date
cvl:birth_date rdf:type owl:DatatypeProperty ;
               rdfs:domain cvl:Patient ;
               rdfs:range xsd:date ;
               rdfs:label "Birth date"@en ,
                          "Data di nascita"@it ;
               skos:definition "The patient's date of birth. Used to calculate their age."@en .


###  http://irst.emr.it/cvl/body_metric_unit
