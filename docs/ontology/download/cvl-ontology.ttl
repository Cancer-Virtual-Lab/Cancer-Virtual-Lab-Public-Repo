#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://irst.emr.it/cvl/TNM_code
cvl:TNM_code rdf:type owl:ObjectProperty ;
             rdfs:domain cvl:TNMClassification ;
             rdfs:range owl:Thing ;
             rdfs:label "Codice della classificazione TNM"@it ,
                        "TNM code"@en ;
             skos:definition "Identifier code for a TNM classification entity."@en .


###  http://irst.emr.it/cvl/active_substance_code
cvl:active_substance_code rdf:type owl:ObjectProperty ;
                          rdfs:domain cvl:ActiveSubstance ;
                          rdfs:range owl:Thing ;
                          rdfs:label "Active substance code"@en ,
                                     "Codice del principio attivo"@it ;
                          skos:definition "The specific identifier or code for a drug, medication, or active clinical substance."@en .


###  http://irst.emr.it/cvl/address_diagnosis
cvl:address_diagnosis rdf:type owl:ObjectProperty ;
                      owl:inverseOf cvl:is_addressed_by ;
                      rdfs:domain cvl:Therapy ;
                      rdfs:range cvl:Diagnosis ;
                      rdfs:label "Address diagnosis"@en ,
                                 "Affronta la diagnosi"@it ;
                      skos:definition "Relates a therapy, treatment, or clinical management plan to the specific diagnosis or disease it is intended to treat."@en .


###  http://irst.emr.it/cvl/administer_active_substance
cvl:administer_active_substance rdf:type owl:ObjectProperty ;
                                owl:inverseOf cvl:is_administered_in ;
                                rdfs:domain cvl:Administration ;
                                rdfs:range cvl:ActiveSubstance ;
                                rdfs:label "Administer active substance"@en ,
                                           "Somministra principio attivo"@it ;
                                skos:definition "Links a medical administration event to the specific active substance, drug, medicine, or chemical agent given to the patient."@en .


###  http://irst.emr.it/cvl/adverse_event_code
cvl:adverse_event_code rdf:type owl:ObjectProperty ;
                       rdfs:domain cvl:AdverseEventEffect ;
                       rdfs:range owl:Thing ;
                       rdfs:label "Adverse event code"@en ,
                                  "Codice dell'evento avverso"@it ;
                       skos:definition "The identifier code for a side effect, toxicity, or adverse medical event."@en .


###  http://irst.emr.it/cvl/causes
cvl:causes rdf:type owl:ObjectProperty ;
           rdfs:domain cvl:Administration ;
           rdfs:range cvl:AdverseEvent ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           owl:inverseOf cvl:is_due_to ;
           rdfs:label "Causa"@it ,
                      "Causes"@en ;
           skos:definition "Indicates that a drug administration is associated with the onset of a specific adverse event."@en .


###  http://irst.emr.it/cvl/characterizes_diagnosis
cvl:characterizes_diagnosis rdf:type owl:ObjectProperty ;
                            owl:inverseOf cvl:is_characterized_by ;
                            rdfs:domain cvl:TNM ;
                            rdfs:range cvl:Diagnosis ;
                            rdfs:label "Caratterizza diagnosi"@it ,
                                       "Characterizes diagnosis"@en ;
                            skos:definition "Links a TNM staging classification to the specific tumor diagnosis it characterizes."@en .


###  http://irst.emr.it/cvl/exam_code
cvl:exam_code rdf:type owl:ObjectProperty ;
              rdfs:domain cvl:Variant ;
              rdfs:range owl:Thing ;
              rdfs:label "Codice dell'esame"@it ,
                         "Exam code"@en ;
              skos:definition "The identifier for a genetic variant examination, sequencing, or molecular test."@en .


###  http://irst.emr.it/cvl/has_ECOG_status
cvl:has_ECOG_status rdf:type owl:ObjectProperty ;
                    owl:inverseOf cvl:is_ECOG_status_of ;
                    rdfs:domain cvl:Patient ;
                    rdfs:range cvl:ECOGStatus ;
                    rdfs:label "Ha ECOG"@it ,
                               "Has ECOG status"@en ;
                    skos:definition "Links a patient to an assessment of their ECOG performance status."@en .


###  http://irst.emr.it/cvl/has_administration
cvl:has_administration rdf:type owl:ObjectProperty ;
                       owl:inverseOf cvl:is_based_on_therapy ;
                       rdfs:domain cvl:Therapy ;
                       rdfs:range cvl:Administration ;
                       rdfs:label "Ha somministrazione"@it ,
                                  "Has administration"@en ;
                       skos:definition "Links a therapy or treatment plan to the specific dates and events when drugs or medications were administered to the patient."@en .


###  http://irst.emr.it/cvl/has_biomarker
cvl:has_biomarker rdf:type owl:ObjectProperty ;
                  owl:inverseOf cvl:is_biomarker_of ;
                  rdfs:domain cvl:Patient ;
                  rdfs:range cvl:Biomarker ;
                  rdfs:label "Ha biomarker"@it ,
                             "Has biomarker"@en ;
                  skos:definition "Connects a patient to a biomarker test, genetic marker finding, or molecular profile result (e.g., PD-L1, HER2)."@en .


###  http://irst.emr.it/cvl/has_body_measurement
cvl:has_body_measurement rdf:type owl:ObjectProperty ;
                         owl:inverseOf cvl:is_body_measurement_of ;
                         rdfs:domain cvl:Patient ;
                         rdfs:range cvl:BodyMeasurement ;
                         rdfs:label "Ha peso e altezza"@it ,
                                    "Has body measurement"@en ;
                         skos:definition "Links a patient to their physical body measurements, such as their recorded height or weight."@en .


###  http://irst.emr.it/cvl/has_body_metric
cvl:has_body_metric rdf:type owl:ObjectProperty ;
                    owl:inverseOf cvl:is_body_metric_of ;
                    rdfs:domain cvl:BodyMeasurement ;
                    rdfs:range cvl:BodyMetric ;
                    rdfs:label "Ha metrica corporea"@it ,
                               "Has body metric"@en ;
                    skos:definition "Connects a body measurement event to the specific metric recorded (e.g., measuring height or weight)."@en .


###  http://irst.emr.it/cvl/has_cm
cvl:has_cm rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_cm_of ;
           rdfs:domain cvl:ClinicalTNM ;
           rdfs:range cvl:C_M_Class ;
           rdfs:label "Ha presenza clinica di metastasi a distanza (M)"@it ,
                      "Has clinical presence of distant metastasis (M)"@en ;
           skos:definition "Links a clinical TNM staging record to the clinical Metastasis (cM) classification, indicating distant spread."@en .


###  http://irst.emr.it/cvl/has_cn
cvl:has_cn rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_cn_of ;
           rdfs:domain cvl:ClinicalTNM ;
           rdfs:range cvl:C_N_Class ;
           rdfs:label "Ha coinvolgimento clinico dei linfonodi regionali (N)"@it ,
                      "Has clinical spread to regional lymph nodes (N)"@en ;
           skos:definition "Links a clinical TNM staging record to the clinical Node (cN) classification, indicating lymph node involvement."@en .


###  http://irst.emr.it/cvl/has_ct
cvl:has_ct rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_ct_of ;
           rdfs:domain cvl:ClinicalTNM ;
           rdfs:range cvl:C_T_Class ;
           rdfs:label "Ha dimensione del tumore clinica (T)"@it ,
                      "Has clinical tumor size (T)"@en ;
           skos:definition "Links a clinical TNM staging record to the clinical Tumor (cT) classification, indicating primary tumor size."@en .


###  http://irst.emr.it/cvl/has_diagnosis
cvl:has_diagnosis rdf:type owl:ObjectProperty ;
                  owl:inverseOf cvl:is_diagnosis_of ;
                  rdfs:domain cvl:Patient ;
                  rdfs:range cvl:Diagnosis ;
                  rdfs:label "Ha diagnosi"@it ,
                             "Has diagnosis"@en ;
                  skos:definition "Links a patient to a cancer diagnosis."@en .


###  http://irst.emr.it/cvl/has_effect
cvl:has_effect rdf:type owl:ObjectProperty ;
               owl:inverseOf cvl:is_adverse_event_effect_of ;
               rdfs:domain cvl:AdverseEvent ;
               rdfs:range cvl:AdverseEventEffect ;
               rdfs:label "Ha effetto"@it ,
                          "Has effect"@en ;
               skos:definition "Links an adverse event to the specific effect, toxicity grade, and description of the side effect experienced."@en .


###  http://irst.emr.it/cvl/has_gender
cvl:has_gender rdf:type owl:ObjectProperty ;
               rdfs:domain cvl:Patient ;
               rdfs:range cvl:SexAssignedAtBirth ;
               rdfs:label "Ha genere"@it ,
                          "Has gender"@en ;
               skos:definition "Specifies the sex assigned at birth of a patient."@en .


###  http://irst.emr.it/cvl/has_height
cvl:has_height rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf cvl:has_body_metric ;
               rdfs:domain cvl:BodyMeasurement ;
               rdfs:range cvl:Height ;
               rdfs:label "Ha altezza"@it ,
                          "Has height"@en ;
               skos:definition "Links a body measurement event specifically to the patient's height metric."@en .


###  http://irst.emr.it/cvl/has_laboratory_test
cvl:has_laboratory_test rdf:type owl:ObjectProperty ;
                        owl:inverseOf cvl:is_laboratory_test_of ;
                        rdfs:domain cvl:Patient ;
                        rdfs:range cvl:LaboratoryTest ;
                        rdfs:label "Ha esame di laboratorio"@it ,
                                   "Has laboratory test"@en ;
                        skos:definition "Connects a patient to blood tests, lab work, hematology, or other laboratory examinations."@en .


###  http://irst.emr.it/cvl/has_line_of_therapy
cvl:has_line_of_therapy rdf:type owl:ObjectProperty ;
                        rdfs:domain cvl:Therapy ;
                        rdfs:range cvl:LineOfTherapy ;
                        rdfs:label "Ha linea di terapia"@it ,
                                   "Has line of therapy"@en ;
                        skos:definition "Indicates the sequential line of therapy (e.g., first-line, second-line, third-line) for a specific treatment plan."@en .


###  http://irst.emr.it/cvl/has_physiological_history
cvl:has_physiological_history rdf:type owl:ObjectProperty ;
                              owl:inverseOf cvl:is_physiological_history_of ;
                              rdfs:domain cvl:Patient ;
                              rdfs:range cvl:PhysiologicalHistory ;
                              rdfs:label "Ha anamnesi fisiologica"@it ,
                                         "Has physiological history"@en ;
                              skos:definition "Links a patient to their lifestyle habits, physiological background, and history such as smoking or alcohol consumption."@en .


###  http://irst.emr.it/cvl/has_pm
cvl:has_pm rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_pm_of ;
           rdfs:domain cvl:PathologicalTNM ;
           rdfs:range cvl:P_M_Class ;
           rdfs:label "Ha presenza patologica di metastasi a distanza (M)"@it ,
                      "Has pathological presence of distant metastasis (M)"@en ;
           skos:definition "Links a pathological TNM staging record to the pathological Metastasis (pM) classification."@en .


###  http://irst.emr.it/cvl/has_pn
cvl:has_pn rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_pn_of ;
           rdfs:domain cvl:PathologicalTNM ;
           rdfs:range cvl:P_N_Class ;
           rdfs:label "Ha coinvolgimento patologico dei linfonodi regionali (N)"@it ,
                      "Has pathological spread to regional lymph nodes (N)"@en ;
           skos:definition "Links a pathological TNM staging record to the pathological Node (pN) classification."@en .


###  http://irst.emr.it/cvl/has_pt
cvl:has_pt rdf:type owl:ObjectProperty ;
           owl:inverseOf cvl:is_pt_of ;
           rdfs:domain cvl:PathologicalTNM ;
           rdfs:range cvl:P_T_Class ;
           rdfs:label "Ha dimensione del tumore patologica (T)"@it ,
                      "Has pathological tumor size (T)"@en ;
           skos:definition "Links a pathological TNM staging record to the pathological Tumor (pT) classification."@en .


###  http://irst.emr.it/cvl/has_response
cvl:has_response rdf:type owl:ObjectProperty ;
                 owl:inverseOf cvl:is_response_of ;
                 rdfs:domain cvl:Patient ;
                 rdfs:range cvl:Response ;
                 rdfs:label "Ha risposta al trattamento"@it ,
                            "Has response"@en ;
                 skos:definition "Connects a patient to their treatment response, clinical outcome, or disease progression status (e.g., complete response, stable disease)."@en .


###  http://irst.emr.it/cvl/has_service
cvl:has_service rdf:type owl:ObjectProperty ;
                owl:inverseOf cvl:is_service_of ;
                rdfs:domain cvl:Patient ;
                rdfs:range cvl:Service ;
                rdfs:label "Ha prestazione clinica"@it ,
                           "Has clinical service"@en ;
                skos:definition "Links a patient to a clinical service or procedure they received."@en .


###  http://irst.emr.it/cvl/has_symptom_assessment
cvl:has_symptom_assessment rdf:type owl:ObjectProperty ;
                           owl:inverseOf cvl:is_symptom_assessment_of ;
                           rdfs:domain cvl:Patient ;
                           rdfs:range cvl:SymptomAssessment ;
                           rdfs:label "Ha valutazione ESAS"@it ,
                                      "Has symptom assessment"@en ;
                           skos:definition "Links a patient to an ESAS (Edmonton Symptom Assessment System) evaluation, measuring pain, fatigue, and palliative symptoms."@en .


###  http://irst.emr.it/cvl/has_symptom_assessment_finding
cvl:has_symptom_assessment_finding rdf:type owl:ObjectProperty ;
                                   rdfs:domain cvl:SymptomAssessment ;
                                   rdfs:range cvl:SymptomAssessmentFinding ;
                                   rdfs:label "Ha valutazione"@it ,
                                              "Has finding"@en ;
                                   skos:definition "Connects a symptom assessment survey to a specific symptom finding and its numeric severity score."@en .


###  http://irst.emr.it/cvl/has_target_value
cvl:has_target_value rdf:type owl:ObjectProperty ;
                     rdfs:domain cvl:ECOGStatus ;
                     rdfs:range cvl:ECOGPerformanceStatusFinding ;
                     rdfs:label "Ha valore"@it ,
                                "Has value"@en ;
                     skos:definition "Links an ECOG performance status to the specific numeric grade (e.g., Grade 0 to Grade 5) of the patient's health."@en .


###  http://irst.emr.it/cvl/has_therapy
cvl:has_therapy rdf:type owl:ObjectProperty ;
                owl:inverseOf cvl:is_therapy_of ;
                rdfs:domain cvl:Patient ;
                rdfs:range cvl:Therapy ;
                rdfs:label "Ha terapia"@it ,
                           "Has therapy"@en ;
                skos:definition "Links a patient to an oncological therapy."@en .


###  http://irst.emr.it/cvl/has_therapy_setting
cvl:has_therapy_setting rdf:type owl:ObjectProperty ;
                        rdfs:domain cvl:Therapy ;
                        rdfs:range cvl:TherapySetting ;
                        rdfs:label "Ha setting"@it ,
                                   "Has setting"@en ;
                        skos:definition "Indicates the clinical setting or intent of a therapy (e.g., adjuvant, neoadjuvant, palliative, advanced, consolidation)."@en .


###  http://irst.emr.it/cvl/has_variant
cvl:has_variant rdf:type owl:ObjectProperty ;
                owl:inverseOf cvl:is_variant_of ;
                rdfs:domain cvl:Patient ;
                rdfs:range cvl:Variant ;
                rdfs:label "Ha variante genetica"@it ,
                           "Has variant"@en ;
                skos:definition "Links a patient to a specific genetic mutation, genomic alteration, or genetic variant detected in their tumor DNA."@en .


###  http://irst.emr.it/cvl/has_weight
cvl:has_weight rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf cvl:has_body_metric ;
               rdfs:domain cvl:BodyMeasurement ;
               rdfs:range cvl:Weight ;
               rdfs:label "Ha peso"@it ,
                          "Has weight"@en ;
               skos:definition "Links a body measurement event specifically to the patient's weight metric."@en .


###  http://irst.emr.it/cvl/is_ECOG_status_of
cvl:is_ECOG_status_of rdf:type owl:ObjectProperty ;
                      rdfs:domain cvl:ECOGStatus ;
                      rdfs:range cvl:Patient ;
                      rdfs:label "Is ECOG status of"@en ,
                                 "È ECOG di"@it ;
                      skos:definition "Reverse link from an ECOG performance status assessment back to the patient."@en .


###  http://irst.emr.it/cvl/is_addressed_by
cvl:is_addressed_by rdf:type owl:ObjectProperty ;
                    rdfs:domain cvl:Diagnosis ;
                    rdfs:range cvl:Therapy ;
                    rdfs:label "Is addressed by"@en ,
                               "È affrontata da"@it ;
                    skos:definition "Reverse link from a disease diagnosis to the therapy or treatment used to address it."@en .


###  http://irst.emr.it/cvl/is_administered_in
cvl:is_administered_in rdf:type owl:ObjectProperty ;
                       rdfs:domain cvl:ActiveSubstance ;
                       rdfs:range cvl:Administration ;
                       rdfs:label "Is administered in"@en ,
                                  "È somministrato in"@it ;
                       skos:definition "Reverse link from an active substance/drug to the administration event."@en .


###  http://irst.emr.it/cvl/is_adverse_event_effect_of
cvl:is_adverse_event_effect_of rdf:type owl:ObjectProperty ;
                               rdfs:domain cvl:AdverseEventEffect ;
                               rdfs:range cvl:AdverseEvent ;
                               rdfs:label "Is adverse event effect of"@en ,
                                          "È effetto di evento avverso di"@it ;
                               skos:definition "Reverse link from a specific adverse effect or toxicity back to the overarching adverse event."@en .


###  http://irst.emr.it/cvl/is_based_on_therapy
cvl:is_based_on_therapy rdf:type owl:ObjectProperty ;
                        rdfs:domain cvl:Administration ;
                        rdfs:range cvl:Therapy ;
                        rdfs:label "Is based on therapy"@en ,
                                   "È basata su terapia"@it ;
                        skos:definition "Reverse link from a single administration event back to the broad therapy plan it belongs to."@en .


###  http://irst.emr.it/cvl/is_biomarker_of
cvl:is_biomarker_of rdf:type owl:ObjectProperty ;
                    rdfs:domain cvl:Biomarker ;
                    rdfs:range cvl:Patient ;
                    rdfs:label "Is biomarker of"@en ,
                               "È biomarker di"@it ;
                    skos:definition "Reverse link from a biomarker test result back to the patient."@en .


###  http://irst.emr.it/cvl/is_body_measurement_of
cvl:is_body_measurement_of rdf:type owl:ObjectProperty ;
                           rdfs:domain cvl:BodyMeasurement ;
                           rdfs:range cvl:Patient ;
                           rdfs:label "Is body measurement of"@en ,
                                      "È peso e altezza di"@it ;
                           skos:definition "Reverse link from a body measurement event back to the patient."@en .


###  http://irst.emr.it/cvl/is_body_metric_of
cvl:is_body_metric_of rdf:type owl:ObjectProperty ;
                      rdfs:domain cvl:BodyMetric ;
                      rdfs:range cvl:BodyMeasurement ;
                      rdfs:label "Is body metric of"@en ,
                                 "È metrica corporea di"@it ;
                      skos:definition "Reverse link from a specific height/weight metric back to the body measurement event."@en .


###  http://irst.emr.it/cvl/is_characterized_by
cvl:is_characterized_by rdf:type owl:ObjectProperty ;
                        rdfs:domain cvl:Diagnosis ;
                        rdfs:range cvl:TNM ;
                        rdfs:label "Is characterized by"@en ,
                                   "È caratterizzata da"@it ;
                        skos:definition "Links a diagnosis to the TNM staging classification that characterizes it."@en .


###  http://irst.emr.it/cvl/is_characterized_by_clinical_tnm
