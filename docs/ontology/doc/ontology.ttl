@prefix : <http://irst.emr.it/cvl/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://irst.emr.it/cvl/> .

<http://irst.emr.it/cvl/> rdf:type owl:Ontology ;
                           owl:versionIRI <http://irst.emr.it/cvl/1.1.0> ;
                           <http://purl.org/dc/terms/bibliographicCitation> "Giorgetti L, Carbonaro A, Ridolfi L, Pasolini R, Pagliarani A, Cavallucci M, Andalò A, Del Gaudio L, De Angelis P, Vespignani R, Gentili N. Cancer Virtual Lab Ontology (CVL-O), version 1.1.0. Zenodo; 2026. https://doi.org/10.5281/zenodo.23762955" ;
                           <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-0066-9172> ,
                                                                  <https://orcid.org/0000-0002-3890-4852> ,
                                                                  <https://orcid.org/0000-0003-3676-171X> ,
                                                                  <https://orcid.org/0009-0000-4148-5954> ,
                                                                  <https://orcid.org/0009-0005-8022-0242> ,
                                                                  <https://orcid.org/0009-0007-4241-3005> ,
                                                                  "Lorenzo Ridolfi" ,
                                                                  "Martina Cavallucci" ,
                                                                  "Paolo De Angelis" ,
                                                                  "Roberto Pasolini" ;
                           <http://purl.org/dc/terms/created> "2025-01-30"^^xsd:date ;
                           <http://purl.org/dc/terms/creator> <https://orcid.org/0009-0002-9475-0744> ;
                           <http://purl.org/dc/terms/description> "The Cancer Virtual Lab Ontology (CVL-O) is an OWL 2 ontology for representing the oncological care pathway of patients from real-world clinical data: diagnosis and TNM staging, therapies and drug administrations, adverse events, biomarkers, genomic variants, laboratory tests, body measurements, symptom assessments, treatment response and clinical services. It is aligned with HL7 FHIR and reuses standard biomedical terminologies (SNOMED CT, LOINC, NCIt, ICD-10, ATC). CVL-O is the semantic foundation of the Cancer Virtual Lab project, a collaboration between the University of Bologna, IRCCS Istituto Romagnolo per lo Studio dei Tumori (IRST) \"Dino Amadori\", Aivolution Srl and IFAB (International Foundation Big Data and Artificial Intelligence for Human Development), and underpins the Cancer Virtual Lab knowledge graph."@en ;
                           <http://purl.org/dc/terms/isPartOf> <https://doi.org/10.5281/zenodo.23762955> ;
                           <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                           <http://purl.org/dc/terms/modified> "2026-10-30"^^xsd:date ;
                           <http://purl.org/dc/terms/title> "Cancer Virtual Lab Ontology (CVL-O)"@en ;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "cvl" ;
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://irst.emr.it/cvl/" ;
                           rdfs:comment "The clinical definitions (skos:definition) of CVL-O 1.1.0 have been reviewed and validated by the biomedical team of the Cancer Virtual Lab project."@en ;
                           rdfs:seeAlso <https://cancer-virtual-lab.github.io/Cancer-Virtual-Lab-Public-Repo/> ,
                                        <https://github.com/Cancer-Virtual-Lab/Cancer-Virtual-Lab-Public-Repo> ;
                           owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isPartOf
<http://purl.org/dc/terms/isPartOf> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://irst.emr.it/cvl/TNM_code
:TNM_code rdf:type owl:ObjectProperty ;
          rdfs:domain :TNMClassification ;
          rdfs:range owl:Thing ;
          rdfs:label "Codice della classificazione TNM"@it ,
                     "TNM code"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for a TNM classification entity."@en .


###  http://irst.emr.it/cvl/active_substance_code
:active_substance_code rdf:type owl:ObjectProperty ;
                       rdfs:domain :ActiveSubstance ;
                       rdfs:range owl:Thing ;
                       rdfs:label "Active substance code"@en ,
                                  "Codice del principio attivo"@it ;
                       <http://www.w3.org/2004/02/skos/core#definition> "The specific identifier or code for a drug, medication, or active clinical substance."@en .


###  http://irst.emr.it/cvl/address_diagnosis
:address_diagnosis rdf:type owl:ObjectProperty ;
                   owl:inverseOf :is_addressed_by ;
                   rdfs:domain :Therapy ;
                   rdfs:range :Diagnosis ;
                   rdfs:label "Address diagnosis"@en ,
                              "Affronta la diagnosi"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a therapy, treatment, or clinical management plan to the specific diagnosis or disease it is intended to treat."@en .


###  http://irst.emr.it/cvl/administer_active_substance
:administer_active_substance rdf:type owl:ObjectProperty ;
                             owl:inverseOf :is_administered_in ;
                             rdfs:domain :Administration ;
                             rdfs:range :ActiveSubstance ;
                             rdfs:label "Administer active substance"@en ,
                                        "Somministra principio attivo"@it ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Links a medical administration event to the specific active substance, drug, medicine, or chemical agent given to the patient."@en .


###  http://irst.emr.it/cvl/adverse_event_code
:adverse_event_code rdf:type owl:ObjectProperty ;
                    rdfs:domain :AdverseEventEffect ;
                    rdfs:range owl:Thing ;
                    rdfs:label "Adverse event code"@en ,
                               "Codice dell'evento avverso"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The identifier code for a side effect, toxicity, or adverse medical event."@en .


###  http://irst.emr.it/cvl/causes
:causes rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        owl:inverseOf :is_due_to ;
        rdfs:domain :Administration ;
        rdfs:range :AdverseEvent ;
        rdfs:label "Causa"@it ,
                   "Causes"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Indicates that a drug administration is associated with the onset of a specific adverse event."@en .


###  http://irst.emr.it/cvl/characterizes_diagnosis
:characterizes_diagnosis rdf:type owl:ObjectProperty ;
                         owl:inverseOf :is_characterized_by ;
                         rdfs:domain :TNM ;
                         rdfs:range :Diagnosis ;
                         rdfs:label "Caratterizza diagnosi"@it ,
                                    "Characterizes diagnosis"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Links a TNM staging classification to the specific tumor diagnosis it characterizes."@en .


###  http://irst.emr.it/cvl/exam_code
:exam_code rdf:type owl:ObjectProperty ;
           rdfs:domain :Variant ;
           rdfs:range owl:Thing ;
           rdfs:label "Codice dell'esame"@it ,
                      "Exam code"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The identifier for a genetic variant examination, sequencing, or molecular test."@en .


###  http://irst.emr.it/cvl/has_ECOG_status
:has_ECOG_status rdf:type owl:ObjectProperty ;
                 owl:inverseOf :is_ECOG_status_of ;
                 rdfs:domain :Patient ;
                 rdfs:range :ECOGStatus ;
                 rdfs:label "Ha ECOG"@it ,
                            "Has ECOG status"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to an assessment of their ECOG performance status."@en .


###  http://irst.emr.it/cvl/has_administration
:has_administration rdf:type owl:ObjectProperty ;
                    owl:inverseOf :is_based_on_therapy ;
                    rdfs:domain :Therapy ;
                    rdfs:range :Administration ;
                    rdfs:label "Ha somministrazione"@it ,
                               "Has administration"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Links a therapy or treatment plan to the specific dates and events when drugs or medications were administered to the patient."@en .


###  http://irst.emr.it/cvl/has_biomarker
:has_biomarker rdf:type owl:ObjectProperty ;
               owl:inverseOf :is_biomarker_of ;
               rdfs:domain :Patient ;
               rdfs:range :Biomarker ;
               rdfs:label "Ha biomarker"@it ,
                          "Has biomarker"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Connects a patient to a biomarker test, genetic marker finding, or molecular profile result (e.g., PD-L1, HER2)."@en .


###  http://irst.emr.it/cvl/has_body_measurement
:has_body_measurement rdf:type owl:ObjectProperty ;
                      owl:inverseOf :is_body_measurement_of ;
                      rdfs:domain :Patient ;
                      rdfs:range :BodyMeasurement ;
                      rdfs:label "Ha peso e altezza"@it ,
                                 "Has body measurement"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to their physical body measurements, such as their recorded height or weight."@en .


###  http://irst.emr.it/cvl/has_body_metric
:has_body_metric rdf:type owl:ObjectProperty ;
                 owl:inverseOf :is_body_metric_of ;
                 rdfs:domain :BodyMeasurement ;
                 rdfs:range :BodyMetric ;
                 rdfs:label "Ha metrica corporea"@it ,
                            "Has body metric"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Connects a body measurement event to the specific metric recorded (e.g., measuring height or weight)."@en .


###  http://irst.emr.it/cvl/has_cm
:has_cm rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_cm_of ;
        rdfs:domain :ClinicalTNM ;
        rdfs:range :C_M_Class ;
        rdfs:label "Ha presenza clinica di metastasi a distanza (M)"@it ,
                   "Has clinical presence of distant metastasis (M)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a clinical TNM staging record to the clinical Metastasis (cM) classification, indicating distant spread."@en .


###  http://irst.emr.it/cvl/has_cn
:has_cn rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_cn_of ;
        rdfs:domain :ClinicalTNM ;
        rdfs:range :C_N_Class ;
        rdfs:label "Ha coinvolgimento clinico dei linfonodi regionali (N)"@it ,
                   "Has clinical spread to regional lymph nodes (N)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a clinical TNM staging record to the clinical Node (cN) classification, indicating lymph node involvement."@en .


###  http://irst.emr.it/cvl/has_ct
:has_ct rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_ct_of ;
        rdfs:domain :ClinicalTNM ;
        rdfs:range :C_T_Class ;
        rdfs:label "Ha dimensione del tumore clinica (T)"@it ,
                   "Has clinical tumor size (T)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a clinical TNM staging record to the clinical Tumor (cT) classification, indicating primary tumor size."@en .


###  http://irst.emr.it/cvl/has_diagnosis
:has_diagnosis rdf:type owl:ObjectProperty ;
               owl:inverseOf :is_diagnosis_of ;
               rdfs:domain :Patient ;
               rdfs:range :Diagnosis ;
               rdfs:label "Ha diagnosi"@it ,
                          "Has diagnosis"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to a cancer diagnosis."@en .


###  http://irst.emr.it/cvl/has_effect
:has_effect rdf:type owl:ObjectProperty ;
            owl:inverseOf :is_adverse_event_effect_of ;
            rdfs:domain :AdverseEvent ;
            rdfs:range :AdverseEventEffect ;
            rdfs:label "Ha effetto"@it ,
                       "Has effect"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Links an adverse event to the specific effect, toxicity grade, and description of the side effect experienced."@en .


###  http://irst.emr.it/cvl/has_gender
:has_gender rdf:type owl:ObjectProperty ;
            rdfs:domain :Patient ;
            rdfs:range :SexAssignedAtBirth ;
            rdfs:label "Ha genere"@it ,
                       "Has gender"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Specifies the sex assigned at birth of a patient."@en .


###  http://irst.emr.it/cvl/has_height
:has_height rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :has_body_metric ;
            rdfs:domain :BodyMeasurement ;
            rdfs:range :Height ;
            rdfs:label "Ha altezza"@it ,
                       "Has height"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Links a body measurement event specifically to the patient's height metric."@en .


###  http://irst.emr.it/cvl/has_laboratory_test
:has_laboratory_test rdf:type owl:ObjectProperty ;
                     owl:inverseOf :is_laboratory_test_of ;
                     rdfs:domain :Patient ;
                     rdfs:range :LaboratoryTest ;
                     rdfs:label "Ha esame di laboratorio"@it ,
                                "Has laboratory test"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Connects a patient to blood tests, lab work, hematology, or other laboratory examinations."@en .


###  http://irst.emr.it/cvl/has_line_of_therapy
:has_line_of_therapy rdf:type owl:ObjectProperty ;
                     rdfs:domain :Therapy ;
                     rdfs:range :LineOfTherapy ;
                     rdfs:label "Ha linea di terapia"@it ,
                                "Has line of therapy"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Indicates the sequential line of therapy (e.g., first-line, second-line, third-line) for a specific treatment plan."@en .


###  http://irst.emr.it/cvl/has_physiological_history
:has_physiological_history rdf:type owl:ObjectProperty ;
                           owl:inverseOf :is_physiological_history_of ;
                           rdfs:domain :Patient ;
                           rdfs:range :PhysiologicalHistory ;
                           rdfs:label "Ha anamnesi fisiologica"@it ,
                                      "Has physiological history"@en ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to their lifestyle habits, physiological background, and history such as smoking or alcohol consumption."@en .


###  http://irst.emr.it/cvl/has_pm
:has_pm rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_pm_of ;
        rdfs:domain :PathologicalTNM ;
        rdfs:range :P_M_Class ;
        rdfs:label "Ha presenza patologica di metastasi a distanza (M)"@it ,
                   "Has pathological presence of distant metastasis (M)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a pathological TNM staging record to the pathological Metastasis (pM) classification."@en .


###  http://irst.emr.it/cvl/has_pn
:has_pn rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_pn_of ;
        rdfs:domain :PathologicalTNM ;
        rdfs:range :P_N_Class ;
        rdfs:label "Ha coinvolgimento patologico dei linfonodi regionali (N)"@it ,
                   "Has pathological spread to regional lymph nodes (N)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a pathological TNM staging record to the pathological Node (pN) classification."@en .


###  http://irst.emr.it/cvl/has_pt
:has_pt rdf:type owl:ObjectProperty ;
        owl:inverseOf :is_pt_of ;
        rdfs:domain :PathologicalTNM ;
        rdfs:range :P_T_Class ;
        rdfs:label "Ha dimensione del tumore patologica (T)"@it ,
                   "Has pathological tumor size (T)"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a pathological TNM staging record to the pathological Tumor (pT) classification."@en .


###  http://irst.emr.it/cvl/has_response
:has_response rdf:type owl:ObjectProperty ;
              owl:inverseOf :is_response_of ;
              rdfs:domain :Patient ;
              rdfs:range :Response ;
              rdfs:label "Ha risposta al trattamento"@it ,
                         "Has response"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Connects a patient to their treatment response, clinical outcome, or disease progression status (e.g., complete response, stable disease)."@en .


###  http://irst.emr.it/cvl/has_service
:has_service rdf:type owl:ObjectProperty ;
             owl:inverseOf :is_service_of ;
             rdfs:domain :Patient ;
             rdfs:range :Service ;
             rdfs:label "Ha prestazione clinica"@it ,
                        "Has clinical service"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to a clinical service or procedure they received."@en .


###  http://irst.emr.it/cvl/has_symptom_assessment
:has_symptom_assessment rdf:type owl:ObjectProperty ;
                        owl:inverseOf :is_symptom_assessment_of ;
                        rdfs:domain :Patient ;
                        rdfs:range :SymptomAssessment ;
                        rdfs:label "Ha valutazione ESAS"@it ,
                                   "Has symptom assessment"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to an ESAS (Edmonton Symptom Assessment System) evaluation, measuring pain, fatigue, and palliative symptoms."@en .


###  http://irst.emr.it/cvl/has_symptom_assessment_finding
:has_symptom_assessment_finding rdf:type owl:ObjectProperty ;
                                rdfs:domain :SymptomAssessment ;
                                rdfs:range :SymptomAssessmentFinding ;
                                rdfs:label "Ha valutazione"@it ,
                                           "Has finding"@en ;
                                <http://www.w3.org/2004/02/skos/core#definition> "Connects a symptom assessment survey to a specific symptom finding and its numeric severity score."@en .


###  http://irst.emr.it/cvl/has_target_value
:has_target_value rdf:type owl:ObjectProperty ;
                  rdfs:domain :ECOGStatus ;
                  rdfs:range :ECOGPerformanceStatusFinding ;
                  rdfs:label "Ha valore"@it ,
                             "Has value"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Links an ECOG performance status to the specific numeric grade (e.g., Grade 0 to Grade 5) of the patient's health."@en .


###  http://irst.emr.it/cvl/has_therapy
:has_therapy rdf:type owl:ObjectProperty ;
             owl:inverseOf :is_therapy_of ;
             rdfs:domain :Patient ;
             rdfs:range :Therapy ;
             rdfs:label "Ha terapia"@it ,
                        "Has therapy"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to an oncological therapy."@en .


###  http://irst.emr.it/cvl/has_therapy_setting
:has_therapy_setting rdf:type owl:ObjectProperty ;
                     rdfs:domain :Therapy ;
                     rdfs:range :TherapySetting ;
                     rdfs:label "Ha setting"@it ,
                                "Has setting"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Indicates the clinical setting or intent of a therapy (e.g., adjuvant, neoadjuvant, palliative, advanced, consolidation)."@en .


###  http://irst.emr.it/cvl/has_variant
:has_variant rdf:type owl:ObjectProperty ;
             owl:inverseOf :is_variant_of ;
             rdfs:domain :Patient ;
             rdfs:range :Variant ;
             rdfs:label "Ha variante genetica"@it ,
                        "Has variant"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a patient to a specific genetic mutation, genomic alteration, or genetic variant detected in their tumor DNA."@en .


###  http://irst.emr.it/cvl/has_weight
:has_weight rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :has_body_metric ;
            rdfs:domain :BodyMeasurement ;
            rdfs:range :Weight ;
            rdfs:label "Ha peso"@it ,
                       "Has weight"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Links a body measurement event specifically to the patient's weight metric."@en .


###  http://irst.emr.it/cvl/is_ECOG_status_of
:is_ECOG_status_of rdf:type owl:ObjectProperty ;
                   rdfs:domain :ECOGStatus ;
                   rdfs:range :Patient ;
                   rdfs:label "Is ECOG status of"@en ,
                              "È ECOG di"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from an ECOG performance status assessment back to the patient."@en .


###  http://irst.emr.it/cvl/is_addressed_by
:is_addressed_by rdf:type owl:ObjectProperty ;
                 rdfs:domain :Diagnosis ;
                 rdfs:range :Therapy ;
                 rdfs:label "Is addressed by"@en ,
                            "È affrontata da"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a disease diagnosis to the therapy or treatment used to address it."@en .


###  http://irst.emr.it/cvl/is_administered_in
:is_administered_in rdf:type owl:ObjectProperty ;
                    rdfs:domain :ActiveSubstance ;
                    rdfs:range :Administration ;
                    rdfs:label "Is administered in"@en ,
                               "È somministrato in"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from an active substance/drug to the administration event."@en .


###  http://irst.emr.it/cvl/is_adverse_event_effect_of
:is_adverse_event_effect_of rdf:type owl:ObjectProperty ;
                            rdfs:domain :AdverseEventEffect ;
                            rdfs:range :AdverseEvent ;
                            rdfs:label "Is adverse event effect of"@en ,
                                       "È effetto di evento avverso di"@it ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a specific adverse effect or toxicity back to the overarching adverse event."@en .


###  http://irst.emr.it/cvl/is_based_on_therapy
:is_based_on_therapy rdf:type owl:ObjectProperty ;
                     rdfs:domain :Administration ;
                     rdfs:range :Therapy ;
                     rdfs:label "Is based on therapy"@en ,
                                "È basata su terapia"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a single administration event back to the broad therapy plan it belongs to."@en .


###  http://irst.emr.it/cvl/is_biomarker_of
:is_biomarker_of rdf:type owl:ObjectProperty ;
                 rdfs:domain :Biomarker ;
                 rdfs:range :Patient ;
                 rdfs:label "Is biomarker of"@en ,
                            "È biomarker di"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a biomarker test result back to the patient."@en .


###  http://irst.emr.it/cvl/is_body_measurement_of
:is_body_measurement_of rdf:type owl:ObjectProperty ;
                        rdfs:domain :BodyMeasurement ;
                        rdfs:range :Patient ;
                        rdfs:label "Is body measurement of"@en ,
                                   "È peso e altezza di"@it ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a body measurement event back to the patient."@en .


###  http://irst.emr.it/cvl/is_body_metric_of
:is_body_metric_of rdf:type owl:ObjectProperty ;
                   rdfs:domain :BodyMetric ;
                   rdfs:range :BodyMeasurement ;
                   rdfs:label "Is body metric of"@en ,
                              "È metrica corporea di"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a specific height/weight metric back to the body measurement event."@en .


###  http://irst.emr.it/cvl/is_characterized_by
:is_characterized_by rdf:type owl:ObjectProperty ;
                     rdfs:domain :Diagnosis ;
                     rdfs:range :TNM ;
                     rdfs:label "Is characterized by"@en ,
                                "È caratterizzata da"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Links a diagnosis to the TNM staging classification that characterizes it."@en .


###  http://irst.emr.it/cvl/is_characterized_by_clinical_tnm
:is_characterized_by_clinical_tnm rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf :is_characterized_by ;
                                  rdfs:domain :Diagnosis ;
                                  rdfs:range :ClinicalTNM ;
                                  rdfs:label "Is characterized by clinical TNM"@en ,
                                             "È caratterizzata da TNM clinico"@it ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a diagnosis specifically to its clinical TNM (cTNM) staging."@en .


###  http://irst.emr.it/cvl/is_characterized_by_pathological_tnm
:is_characterized_by_pathological_tnm rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf :is_characterized_by ;
                                      rdfs:domain :Diagnosis ;
                                      rdfs:range :PathologicalTNM ;
                                      rdfs:label "Is characterized by pathological TNM"@en ,
                                                 "È caratterizzata da TNM patologico"@it ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Relates a diagnosis specifically to its pathological TNM (pTNM) staging after surgery."@en .


###  http://irst.emr.it/cvl/is_cm_of
:is_cm_of rdf:type owl:ObjectProperty ;
          rdfs:domain :C_M_Class ;
          rdfs:range :ClinicalTNM ;
          rdfs:label "Is clinical presence of distant metastasis of"@en ,
                     "È presenza clinica di metastasi a distanza di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a clinical Metastasis (cM) class to the clinical TNM record."@en .


###  http://irst.emr.it/cvl/is_cn_of
:is_cn_of rdf:type owl:ObjectProperty ;
          rdfs:domain :C_N_Class ;
          rdfs:range :ClinicalTNM ;
          rdfs:label "Is clinical spread to regional lymph nodes of"@en ,
                     "È diffusione clinica ai linfonodi regionali di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a clinical Node (cN) class to the clinical TNM record."@en .


###  http://irst.emr.it/cvl/is_ct_of
:is_ct_of rdf:type owl:ObjectProperty ;
          rdfs:domain :C_T_Class ;
          rdfs:range :ClinicalTNM ;
          rdfs:label "Is clinical tumor size of"@en ,
                     "È dimensione clinica del tumore di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a clinical Tumor (cT) class to the clinical TNM record."@en .


###  http://irst.emr.it/cvl/is_diagnosis_of
:is_diagnosis_of rdf:type owl:ObjectProperty ;
                 rdfs:domain :Diagnosis ;
                 rdfs:range :Patient ;
                 rdfs:label "Is diagnosis of"@en ,
                            "È diagnosi di"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a medical diagnosis back to the patient."@en .


###  http://irst.emr.it/cvl/is_due_to
:is_due_to rdf:type owl:ObjectProperty ;
           rdfs:domain :AdverseEvent ;
           rdfs:range :Administration ;
           rdfs:label "Is due to"@en ,
                      "È dovuto a"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "Indicates that an adverse event or side effect is due to a specific administration of a drug."@en .


###  http://irst.emr.it/cvl/is_laboratory_test_of
:is_laboratory_test_of rdf:type owl:ObjectProperty ;
                       rdfs:domain :LaboratoryTest ;
                       rdfs:range :Patient ;
                       rdfs:label "Is laboratory test of"@en ,
                                  "È esame di laboratorio di"@it ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a laboratory blood test back to the patient."@en .


###  http://irst.emr.it/cvl/is_physiological_history_of
:is_physiological_history_of rdf:type owl:ObjectProperty ;
                             rdfs:domain :PhysiologicalHistory ;
                             rdfs:range :Patient ;
                             rdfs:label "Is physiological history of"@en ,
                                        "È anamnesi fisiologica di"@it ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from physiological and lifestyle history (smoking/alcohol) back to the patient."@en .


###  http://irst.emr.it/cvl/is_pm_of
:is_pm_of rdf:type owl:ObjectProperty ;
          rdfs:domain :P_M_Class ;
          rdfs:range :PathologicalTNM ;
          rdfs:label "Is pathological presence of distant metastasis of"@en ,
                     "È presenza patologica di metastasi a distanza di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a pathological Metastasis (pM) class to the pathological TNM record."@en .


###  http://irst.emr.it/cvl/is_pn_of
:is_pn_of rdf:type owl:ObjectProperty ;
          rdfs:domain :P_N_Class ;
          rdfs:range :PathologicalTNM ;
          rdfs:label "Is pathological spread to regional lymph nodes of"@en ,
                     "È diffusione patologica ai linfonodi regionali di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a pathological Node (pN) class to the pathological TNM record."@en .


###  http://irst.emr.it/cvl/is_provided_by
:is_provided_by rdf:type owl:ObjectProperty ;
                owl:inverseOf :provides ;
                rdfs:domain :Service ;
                rdfs:range :Department ;
                rdfs:label "Is provided by"@en ,
                           "È erogata da"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Links a clinical service, procedure, or care event to the hospital department that provided it."@en .


###  http://irst.emr.it/cvl/is_pt_of
:is_pt_of rdf:type owl:ObjectProperty ;
          rdfs:domain :P_T_Class ;
          rdfs:range :PathologicalTNM ;
          rdfs:label "Is pathological tumor size of"@en ,
                     "È dimensione patologica del tumore di"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a pathological Tumor (pT) class to the pathological TNM record."@en .


###  http://irst.emr.it/cvl/is_response_of
:is_response_of rdf:type owl:ObjectProperty ;
                rdfs:domain :Response ;
                rdfs:range :Patient ;
                rdfs:label "Is response of"@en ,
                           "È risposta al trattamento di"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a treatment response outcome back to the patient."@en .


