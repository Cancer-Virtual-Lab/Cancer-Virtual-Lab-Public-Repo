               rdfs:domain :Service ;
               rdfs:range :Patient ;
               rdfs:label "Is service of"@en ,
                          "È prestazione clinica di"@it ;
               <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a clinical service or procedure back to the patient."@en .


###  http://irst.emr.it/cvl/is_symptom_assessment_of
:is_symptom_assessment_of rdf:type owl:ObjectProperty ;
                          rdfs:domain :SymptomAssessment ;
                          rdfs:range :Patient ;
                          rdfs:label "Is symptom assessment of"@en ,
                                     "È valutazione ESAS di"@it ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a symptom assessment (ESAS) back to the patient."@en .


###  http://irst.emr.it/cvl/is_therapy_of
:is_therapy_of rdf:type owl:ObjectProperty ;
               rdfs:domain :Therapy ;
               rdfs:range :Patient ;
               rdfs:label "Is therapy of"@en ,
                          "È terapia di"@it ;
               <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from an oncology therapy or treatment back to the patient."@en .


###  http://irst.emr.it/cvl/is_variant_of
:is_variant_of rdf:type owl:ObjectProperty ;
               rdfs:domain :Variant ;
               rdfs:range :Patient ;
               rdfs:label "Is variant of"@en ,
                          "È variante genetica di"@it ;
               <http://www.w3.org/2004/02/skos/core#definition> "Reverse link from a genetic mutation or variant back to the patient."@en .


###  http://irst.emr.it/cvl/laboratory_code
:laboratory_code rdf:type owl:ObjectProperty ;
                 rdfs:domain :LaboratoryTest ;
                 rdfs:range owl:Thing ;
                 rdfs:label "Codice dell’esame"@it ,
                            "Laboratory code"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for a specific laboratory test."@en .


###  http://irst.emr.it/cvl/marker_code
:marker_code rdf:type owl:ObjectProperty ;
             rdfs:domain :Biomarker ;
             rdfs:range owl:Thing ;
             rdfs:label "Biomarker code"@en ,
                        "Codice del biomarker"@it ;
             <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for a molecular biomarker test."@en .


###  http://irst.emr.it/cvl/marker_value_code
:marker_value_code rdf:type owl:ObjectProperty ;
                   rdfs:domain :Biomarker ;
                   rdfs:range owl:Thing ;
                   rdfs:label "Biomarker value code"@en ,
                              "Codice del valore del biomarker"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for the specific value or outcome of a biomarker test."@en .


###  http://irst.emr.it/cvl/provides
:provides rdf:type owl:ObjectProperty ;
          rdfs:domain :Department ;
          rdfs:range :Service ;
          rdfs:label "Eroga"@it ,
                     "Provides"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Links a hospital department to the specific clinical services it provides to patients."@en .


###  http://irst.emr.it/cvl/response_code
:response_code rdf:type owl:ObjectProperty ;
               rdfs:domain :Response ;
               rdfs:range owl:Thing ;
               rdfs:label "Codice della risposta"@it ,
                          "Response code"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for a clinical treatment response finding."@en .


###  http://irst.emr.it/cvl/service_code
:service_code rdf:type owl:ObjectProperty ;
              rdfs:domain :Service ;
              rdfs:range owl:Thing ;
              rdfs:label "Codice della prestazione"@it ,
                         "Service code"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for a medical procedure, surgery, or clinical service."@en .


###  http://irst.emr.it/cvl/site_code
:site_code rdf:type owl:ObjectProperty ;
           rdfs:domain :Diagnosis ;
           rdfs:range owl:Thing ;
           rdfs:label "Codice della sede anamnestica"@it ,
                      "Site code"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for the anatomical site, organ, or location of a tumor/diagnosis."@en .


###  http://irst.emr.it/cvl/stage_code
:stage_code rdf:type owl:ObjectProperty ;
            rdfs:domain :Diagnosis ;
            rdfs:range owl:Thing ;
            rdfs:label "Codice stadio della malattia"@it ,
                       "Disease stage code"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Identifier code for the overall stage of a cancer diagnosis."@en .


###  http://irst.emr.it/cvl/variant_code
:variant_code rdf:type owl:ObjectProperty ;
              rdfs:domain :Variant ;
              rdfs:range owl:Thing ;
              rdfs:label "Codice della variante"@it ,
                         "Variant code"@en ;
