#################################################################
#    Annotations
#################################################################

:AdjuvantTherapy rdfs:label "Adjuvant therapy"@en ,
                            "Terapia adiuvante"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting given after the primary treatment (like surgery) to lower the risk that the cancer will return."@en .


:AdvancedTherapy rdfs:label "Advanced therapy"@en ,
                            "Terapia avanzata"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting for treating advanced, late-stage, or metastatic cancer that has spread."@en .


:ConcomitantWithRadiotherapy rdfs:label "Concomitant with radiotherapy"@en ,
                                        "Concomitante a radioterapia"@it ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting where systemic treatment (like chemotherapy) is administered concurrently or at the same time as radiation therapy."@en .


:ConsolidationTherapy rdfs:label "Consolidation therapy"@en ,
                                 "Terapia di consolidamento"@it ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting given to kill any cancer cells that may be left after initial treatment to deepen the patient's response."@en .


:ECOGPerformanceStatusFinding0 rdfs:label "Grade 0"@en ,
                                          "Grado 0"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 0, indicating the patient is fully active and able to carry on all pre-disease performance without restriction."@en .


:ECOGPerformanceStatusFinding1 rdfs:label "Grade 1"@en ,
                                          "Grado 1"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 1, indicating the patient is restricted in physically strenuous activity but ambulatory."@en .


:ECOGPerformanceStatusFinding2 rdfs:label "Grade 2"@en ,
                                          "Grado 2"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 2, indicating the patient is ambulatory and capable of all selfcare but unable to carry out any work activities."@en .


:ECOGPerformanceStatusFinding3 rdfs:label "Grade 3"@en ,
                                          "Grado 3"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 3, indicating the patient is capable of only limited selfcare, confined to bed or chair more than 50% of waking hours."@en .


:ECOGPerformanceStatusFinding4 rdfs:label "Grade 4"@en ,
                                          "Grado 4"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 4, indicating the patient is completely disabled, cannot carry on any selfcare, and is totally confined to bed or chair."@en .


:ECOGPerformanceStatusFinding5 rdfs:label "Grade 5"@en ,
                                          "Grado 5"@it ;
                               <http://www.w3.org/2004/02/skos/core#definition> "ECOG Grade 5, indicating the patient is dead."@en .


:Female rdfs:label "Donna"@it ,
                   "Female"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "Female sex assigned at birth."@en .


:InductionTherapy rdfs:label "Induction therapy"@en ,
                             "Terapia ad induzione"@it ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Initial or first-phase therapy setting given to shrink a tumor before other treatments like surgery or radiation."@en .


:LineOfTherapy1 rdfs:label "First line of therapy"@en ,
                           "Prima linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "First-line therapy, the initial treatment regimen given for a disease."@en .


:LineOfTherapy10 rdfs:label "Decima linea di terapia"@it ,
                            "Tenth line of therapy"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Tenth-line therapy, a highly advanced subsequent treatment regimen."@en .


:LineOfTherapy2 rdfs:label "Second line of therapy"@en ,
                           "Seconda linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Second-line therapy, the treatment given when the first-line therapy doesn't work or stops working."@en .


:LineOfTherapy3 rdfs:label "Terza linea di terapia"@it ,
                           "Third line of therapy"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Third-line therapy, given after first- and second-line treatments have failed."@en .


:LineOfTherapy4 rdfs:label "Fourth line of therapy"@en ,
                           "Quarta linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Fourth-line therapy, a subsequent treatment regimen."@en .


:LineOfTherapy5 rdfs:label "Fifth line of therapy"@en ,
                           "Quinta linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Fifth-line therapy, a subsequent treatment regimen."@en .


:LineOfTherapy6 rdfs:label "Sesta linea di terapia"@it ,
                           "Sixth line of therapy"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Sixth-line therapy, a subsequent treatment regimen."@en .


:LineOfTherapy7 rdfs:label "Settima linea di terapia"@it ,
                           "Seventh line of therapy"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Seventh-line therapy, a subsequent treatment regimen."@en .


:LineOfTherapy8 rdfs:label "Eighth line of therapy"@en ,
                           "Ottava linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Eighth-line therapy, a subsequent treatment regimen."@en .


:LineOfTherapy9 rdfs:label "Ninth line of therapy"@en ,
                           "Nona linea di terapia"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "Ninth-line therapy, a subsequent treatment regimen."@en .


:MaintenanceTherapy rdfs:label "Maintenance therapy"@en ,
                               "Terapia di mantenimento"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting intended to help keep cancer from growing after it has shrunk following initial treatment."@en .


:Male rdfs:label "Male"@en ,
                 "Uomo"@it ;
      <http://www.w3.org/2004/02/skos/core#definition> "Male sex assigned at birth."@en .


:NeoadjuvantTherapy rdfs:label "Neoadjuvant therapy"@en ,
                               "Terapia neoadiuvante"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A therapy setting given before the main treatment (usually surgery) to shrink a tumor and make it easier to remove."@en .


:SalvageTherapy1 rdfs:label "First salvage therapy"@en ,
                            "Primo salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "First-line salvage therapy given for relapsed or refractory disease."@en .


:SalvageTherapy10 rdfs:label "Decimo salvataggio"@it ,
                             "Tenth salvage therapy"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Tenth-line salvage therapy."@en .


:SalvageTherapy2 rdfs:label "Second salvage therapy"@en ,
                            "Secondo salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Second-line salvage therapy given for relapsed or refractory disease."@en .


:SalvageTherapy3 rdfs:label "Terzo salvataggio"@it ,
                            "Third salvage therapy"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Third-line salvage therapy given for relapsed or refractory disease."@en .


:SalvageTherapy4 rdfs:label "Fourth salvage therapy"@en ,
                            "Quarto salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Fourth-line salvage therapy."@en .


:SalvageTherapy5 rdfs:label "Fifth salvage therapy"@en ,
                            "Quinto salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Fifth-line salvage therapy."@en .


:SalvageTherapy6 rdfs:label "Sesto salvataggio"@it ,
                            "Sixth salvage therapy"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Sixth-line salvage therapy."@en .


:SalvageTherapy7 rdfs:label "Settimo salvataggio"@it ,
                            "Seventh salvage therapy"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Seventh-line salvage therapy."@en .


:SalvageTherapy8 rdfs:label "Eighth salvage therapy"@en ,
                            "Ottavo salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Eighth-line salvage therapy."@en .


:SalvageTherapy9 rdfs:label "Ninth salvage therapy"@en ,
                            "Nono salvataggio"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Ninth-line salvage therapy."@en .


:UnknownGender rdfs:label "Sconosciuto"@it ,
                          "Unknown"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Assigned when the patient's biological sex is not recorded or known in the system."@en .


