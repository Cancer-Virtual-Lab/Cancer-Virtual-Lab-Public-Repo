                      rdfs:label "Data dell’esame di laboratorio"@it ,
                                 "Laboratory test date"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "The date a blood test or laboratory exam was drawn or performed."@en .


###  http://irst.emr.it/cvl/last_administration_date
:last_administration_date rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Therapy ;
                          rdfs:range xsd:date ;
                          rdfs:label "Data dell’ultima somministrazione della terapia"@it ,
