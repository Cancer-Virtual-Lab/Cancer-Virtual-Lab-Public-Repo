#################################################################
#    Data properties
#################################################################

###  http://irst.emr.it/cvl/ECOG_date
:ECOG_date rdf:type owl:DatatypeProperty ;
           rdfs:domain :ECOGStatus ;
           rdfs:range xsd:date ;
           rdfs:label "Data valutazione ECOG"@it ,
                      "ECOG assessment date"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The date an ECOG performance status was measured or recorded."@en .


###  http://irst.emr.it/cvl/ESAS_date
:ESAS_date rdf:type owl:DatatypeProperty ;
           rdfs:domain :SymptomAssessment ;
           rdfs:range xsd:dateTime ;
           rdfs:label "Data della valutazione ESAS"@it ,
                      "ESAS assessment date"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The date and time a symptom assessment (ESAS) was completed by the patient."@en .


###  http://irst.emr.it/cvl/TNM_value
:TNM_value rdf:type owl:DatatypeProperty ;
           rdfs:domain :TNMClassification ;
           rdfs:range xsd:string ;
           rdfs:label "TNM value"@en ,
                      "Valore della classificazione TNM"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "The string value representing a TNM classification score (e.g., 'T2', 'N1', 'M0')."@en .


###  http://irst.emr.it/cvl/active_substance_description
:active_substance_description rdf:type owl:DatatypeProperty ;
                              rdfs:domain :ActiveSubstance ;
                              rdfs:range xsd:string ;
                              rdfs:label "Active substance description"@en ,
                                         "Descrizione del principio attivo"@it ;
                              <http://www.w3.org/2004/02/skos/core#definition> "The name or textual description of a drug, medication, or active substance (e.g., 'Cisplatin', 'Pembrolizumab')."@en .


###  http://irst.emr.it/cvl/administration_date
:administration_date rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Administration ;
                     rdfs:range xsd:date ;
                     rdfs:label "Administration date"@en ,
                                "Data di somministrazione"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The specific date a drug, medication, or therapy was physically administered to the patient."@en .


###  http://irst.emr.it/cvl/adverse_event_date
:adverse_event_date rdf:type owl:DatatypeProperty ;
                    rdfs:domain :AdverseEvent ;
                    rdfs:range xsd:date ;
                    rdfs:label "Adverse event date"@en ,
                               "Data dell’evento avverso"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The date an adverse event, toxicity, or side effect began."@en .


###  http://irst.emr.it/cvl/adverse_event_description
:adverse_event_description rdf:type owl:DatatypeProperty ;
                           rdfs:domain :AdverseEventEffect ;
                           rdfs:range xsd:string ;
                           rdfs:label "Adverse event description"@en ,
                                      "Descrizione dell'evento avverso"@it ;
                           <http://www.w3.org/2004/02/skos/core#definition> "The text description of a side effect or adverse event (e.g., 'Nausea', 'Neutropenia', 'Rash')."@en .


###  http://irst.emr.it/cvl/alcohol_consumption
:alcohol_consumption rdf:type owl:DatatypeProperty ;
                     rdfs:domain :PhysiologicalHistory ;
                     rdfs:range xsd:boolean ;
                     rdfs:label "Alcohol consumption"@en ,
                                "Consumo di alcol"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Boolean flag (true/false) indicating whether the patient consumes alcohol (is a drinker)."@en .


###  http://irst.emr.it/cvl/amino_acid_change
:amino_acid_change rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Variant ;
                   rdfs:range xsd:string ;
                   rdfs:label "Amino acid change"@en ,
                              "Cambiamento aminoacidico"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The specific protein or amino acid change caused by a genetic variant (e.g., 'V600E', 'L858R')."@en ;
                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://snomed.info/sct/250574005> .


###  http://irst.emr.it/cvl/birth_date
:birth_date rdf:type owl:DatatypeProperty ;
            rdfs:domain :Patient ;
            rdfs:range xsd:date ;
            rdfs:label "Birth date"@en ,
                       "Data di nascita"@it ;
            <http://www.w3.org/2004/02/skos/core#definition> "The patient's date of birth. Used to calculate their age."@en .


###  http://irst.emr.it/cvl/body_metric_unit
:body_metric_unit rdf:type owl:DatatypeProperty ;
                  rdfs:domain :BodyMetric ;
                  rdfs:range xsd:string ;
                  rdfs:label "Body metric unit"@en ,
                             "Unità di misura metrica"@it ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The unit of measure of a body metric value (e.g., 'cm', 'kg')."@en .


###  http://irst.emr.it/cvl/body_metric_value
:body_metric_value rdf:type owl:DatatypeProperty ;
                   rdfs:domain :BodyMetric ;
                   rdfs:range xsd:integer ;
                   rdfs:label "Body metric value"@en ,
                              "Valore metrica"@it ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The numeric integer value of a body measurement (e.g., height in cm, weight in kg)."@en .


###  http://irst.emr.it/cvl/category1
:category1 rdf:type owl:DatatypeProperty ;
           rdfs:domain :Service ;
           rdfs:range xsd:string ;
           rdfs:label "Categoria 1 della prestazione"@it ,
                      "Category 1"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Primary hierarchical classification category for a clinical service or procedure."@en .


###  http://irst.emr.it/cvl/category2
:category2 rdf:type owl:DatatypeProperty ;
           rdfs:domain :Service ;
           rdfs:range xsd:string ;
           rdfs:label "Categoria 2 della prestazione"@it ,
                      "Category 2"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Secondary hierarchical classification category for a clinical service or procedure."@en .


###  http://irst.emr.it/cvl/category3
:category3 rdf:type owl:DatatypeProperty ;
           rdfs:domain :Service ;
           rdfs:range xsd:string ;
           rdfs:label "Categoria 3 della prestazione"@it ,
                      "Category 3"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Tertiary hierarchical classification category for a clinical service or procedure."@en .


###  http://irst.emr.it/cvl/currency
:currency rdf:type owl:DatatypeProperty ;
          rdfs:domain :Service ;
          rdfs:range xsd:string ;
          rdfs:label "Currency"@en ,
                     "Valuta della prestazione"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "The currency used to denominate the price of a clinical service (e.g., 'EUR', 'USD')."@en .


###  http://irst.emr.it/cvl/death_date
:death_date rdf:type owl:DatatypeProperty ;
            rdfs:domain :Patient ;
            rdfs:range xsd:date ;
            rdfs:label "Data di morte"@it ,
                       "Death date"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The date of the patient's death. Used for calculating overall survival and mortality."@en .


###  http://irst.emr.it/cvl/department_code
:department_code rdf:type owl:DatatypeProperty ;
