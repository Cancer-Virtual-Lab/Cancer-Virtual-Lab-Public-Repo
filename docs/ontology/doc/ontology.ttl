                                      "First administration date"@en ;
                           <http://www.w3.org/2004/02/skos/core#definition> "The start date when a patient received the very first dose of a specific line of therapy."@en .


###  http://irst.emr.it/cvl/laboratory_description
:laboratory_description rdf:type owl:DatatypeProperty ;
                        rdfs:domain :LaboratoryTest ;
                        rdfs:range xsd:string ;
                        rdfs:label "Descrizione dell’esame"@it ,
                                   "Laboratory description"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "The name or description of a lab test (e.g., 'Hemoglobin', 'White Blood Cell Count')."@en .


###  http://irst.emr.it/cvl/laboratory_test_date
:laboratory_test_date rdf:type owl:DatatypeProperty ;
                      rdfs:domain :LaboratoryTest ;
