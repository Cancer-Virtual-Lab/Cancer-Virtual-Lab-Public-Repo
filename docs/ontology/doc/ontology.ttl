                 rdfs:range xsd:string ;
                 rdfs:label "Department name"@en ,
                            "Nome del reparto"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The name of the hospital department providing a clinical service (e.g., 'Oncology', 'Radiology')."@en .


###  http://irst.emr.it/cvl/diagnosis_date
:diagnosis_date rdf:type owl:DatatypeProperty ;
