                       rdfs:range xsd:integer ;
                       rdfs:label "Line of therapy value"@en ,
                                  "Valore linea di terapia"@it ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Numeric integer indicating the sequential line of treatment (1 for first-line, 2 for second-line, etc.)."@en .


###  http://irst.emr.it/cvl/marker_date
:marker_date rdf:type owl:DatatypeProperty ;
             rdfs:domain :Biomarker ;
             rdfs:range xsd:date ;
             rdfs:label "Biomarker measurement date"@en ,
                        "Data della misurazione del biomarker"@it ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date a biomarker test or molecular profiling was performed."@en .


###  http://irst.emr.it/cvl/marker_description
:marker_description rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Biomarker ;
                    rdfs:range xsd:string ;
                    rdfs:label "Biomarker description"@en ,
                               "Descrizione del biomarker"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The name of the biomarker tested (e.g., 'PD-L1', 'HER2', 'ALK')."@en .


###  http://irst.emr.it/cvl/marker_value
:marker_value rdf:type owl:DatatypeProperty ;
              rdfs:domain :Biomarker ;
              rdfs:range xsd:string ;
              rdfs:label "Biomarker value"@en ,
                         "Valore del biomarker"@it ;
              <http://www.w3.org/2004/02/skos/core#definition> "The result or status of a biomarker test (e.g., 'Positive', 'Negative', '50% expression')."@en .


###  http://irst.emr.it/cvl/measurement_date
:measurement_date rdf:type owl:DatatypeProperty ;
                  rdfs:domain :BodyMeasurement ;
                  rdfs:range xsd:date ;
                  rdfs:label "Data della misurazione"@it ,
                             "Measurement date"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The date a patient's body measurement (height or weight) was recorded."@en .


###  http://irst.emr.it/cvl/patient_identifier
:patient_identifier rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Patient ;
                    rdfs:range xsd:string ;
                    rdfs:label "Identificativo del paziente"@it ,
                               "Patient identifier"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The unique alphanumeric ID code or medical record number of a patient."@en .


###  http://irst.emr.it/cvl/price
:price rdf:type owl:DatatypeProperty ;
       rdfs:domain :Service ;
       rdfs:range xsd:decimal ;
       rdfs:label "Prezzo della prestazione"@it ,
                  "Price"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "The financial cost, billing amount, or price of a medical service or procedure."@en .


###  http://irst.emr.it/cvl/quantity
:quantity rdf:type owl:DatatypeProperty ;
          rdfs:domain :Service ;
          rdfs:range xsd:decimal ;
          rdfs:label "Quantity"@en ,
                     "Quantità erogata"@it ;
          <http://www.w3.org/2004/02/skos/core#definition> "The count or number of times a specific service or procedure was performed."@en .


###  http://irst.emr.it/cvl/reference_max_unit
:reference_max_unit rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LaboratoryTest ;
                    rdfs:range xsd:string ;
                    rdfs:label "Maximum reference unit"@en ,
                               "Unità del valore massimo di riferimento"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The unit of measurement for a lab test's maximum normal value."@en .


###  http://irst.emr.it/cvl/reference_max_value
:reference_max_value rdf:type owl:DatatypeProperty ;
                     rdfs:domain :LaboratoryTest ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "Maximum reference value"@en ,
                                "Valore massimo di riferimento"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The upper limit of the normal reference range for a laboratory test."@en .


###  http://irst.emr.it/cvl/reference_min_unit
:reference_min_unit rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LaboratoryTest ;
                    rdfs:range xsd:string ;
                    rdfs:label "Minimum reference unit"@en ,
                               "Unità del valore minimo di riferimento"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The unit of measurement for a lab test's minimum normal value."@en .


###  http://irst.emr.it/cvl/reference_min_value
:reference_min_value rdf:type owl:DatatypeProperty ;
                     rdfs:domain :LaboratoryTest ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "Minimum reference value"@en ,
                                "Valore minimo di riferimento"@it ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The lower limit of the normal reference range for a laboratory test."@en .


###  http://irst.emr.it/cvl/response_date
:response_date rdf:type owl:DatatypeProperty ;
               rdfs:domain :Response ;
               rdfs:range xsd:date ;
               rdfs:label "Data della risposta"@it ,
                          "Response date"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The date a clinical response evaluation or tumor restaging was recorded."@en .


###  http://irst.emr.it/cvl/response_description
:response_description rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Response ;
                      rdfs:range xsd:string ;
                      rdfs:label "Descrizione della risposta"@it ,
                                 "Response description"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Free-text description of a clinical response assessment as reported in the source record."@en .


###  http://irst.emr.it/cvl/response_value
:response_value rdf:type owl:DatatypeProperty ;
                rdfs:domain :Response ;
                rdfs:range xsd:string ;
                rdfs:label "Response value"@en ,
                           "Valore della risposta"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "The clinical outcome or tumor response to therapy (e.g., 'Complete Response', 'Progressive Disease', 'Stable Disease')."@en .


###  http://irst.emr.it/cvl/service_date
:service_date rdf:type owl:DatatypeProperty ;
              rdfs:domain :Service ;
              rdfs:range xsd:date ;
              rdfs:label "Data di erogazione della prestazione"@it ,
                         "Service date"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The date a clinical service, imaging scan, or procedure was provided."@en .


###  http://irst.emr.it/cvl/service_description
:service_description rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Service ;
                     rdfs:range xsd:string ;
                     rdfs:label "Descrizione della prestazione"@it ,
                                "Service description"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The text description of a medical procedure, imaging scan, surgery, or clinical service."@en .


###  http://irst.emr.it/cvl/site_description
:site_description rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Diagnosis ;
                  rdfs:range xsd:string ;
                  rdfs:label "Descrizione della sede anamnestica"@it ,
                             "Site description"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The anatomical site, organ, or bodily location where the primary tumor or cancer is located (e.g., 'Lung', 'Breast', 'Colon')."@en .


###  http://irst.emr.it/cvl/smoking
:smoking rdf:type owl:DatatypeProperty ;
         rdfs:domain :PhysiologicalHistory ;
         rdfs:range xsd:boolean ;
         rdfs:label "Fumo"@it ,
                    "Smoking"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "Boolean flag (true/false) indicating whether the patient is a smoker or uses tobacco."@en .


###  http://irst.emr.it/cvl/stage_description
:stage_description rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Diagnosis ;
                   rdfs:range xsd:string ;
                   rdfs:label "Descrizione dello stadio della malattia"@it ,
                              "Disease stage description"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The overall clinical or pathological stage of the cancer (e.g., 'Stage IIIA', 'Stage IV', 'Metastatic')."@en .


###  http://irst.emr.it/cvl/symptom_assessment_value
:symptom_assessment_value rdf:type owl:DatatypeProperty ;
                          rdfs:domain :SymptomAssessmentFinding ;
                          rdfs:range xsd:integer ;
                          rdfs:label "Symptom assessment value"@en ,
                                     "Valore valutazione dei sintomi"@it ;
                          <http://www.w3.org/2004/02/skos/core#definition> "The numeric severity score (usually 0-10) for a specific patient-reported symptom (pain, fatigue, nausea, etc.)."@en .


###  http://irst.emr.it/cvl/target_description
:target_description rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ECOGStatus ;
                    rdfs:range xsd:string ;
                    rdfs:label "Descrizione del target"@it ,
                               "Target description"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The text description of the patient's ECOG performance status (e.g., 'Fully active', 'Restricted in physically strenuous activity')."@en .


###  http://irst.emr.it/cvl/toxicity_grade_description
:toxicity_grade_description rdf:type owl:DatatypeProperty ;
                            rdfs:domain :AdverseEventEffect ;
                            rdfs:range xsd:string ;
                            rdfs:label "Descrizione del grado di tossicità"@it ,
                                       "Toxicity grade description"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Text description of the severity of an adverse event or side effect."@en .


###  http://irst.emr.it/cvl/toxicity_grade_value
:toxicity_grade_value rdf:type owl:DatatypeProperty ;
                      rdfs:domain :AdverseEventEffect ;
                      rdfs:range xsd:integer ;
                      rdfs:label "Toxicity grade value"@en ,
                                 "Valore del grado di tossicità"@it ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Numeric grade (usually 1-5) indicating the severity of an adverse event or clinical toxicity."@en .


###  http://irst.emr.it/cvl/variant2
:variant2 rdf:type owl:DatatypeProperty ;
          rdfs:domain :Variant ;
          rdfs:range xsd:string ;
          rdfs:label "Seconda variante"@it ,
                     "Variant 2"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Additional molecular information or secondary classification about a genetic variant."@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://snomed.info/sct/64195000> .


###  http://irst.emr.it/cvl/variant_date
:variant_date rdf:type owl:DatatypeProperty ;
              rdfs:domain :Variant ;
              rdfs:range xsd:date ;
              rdfs:label "Data della variante"@it ,
                         "Variant date"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The date a genetic variant or mutation was sequenced or detected."@en .


###  http://irst.emr.it/cvl/variant_description
:variant_description rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Variant ;
                     rdfs:range xsd:string ;
                     rdfs:label "Descrizione della variante"@it ,
                                "Variant description"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The name or gene of the detected mutation, variant, or genetic alteration (e.g., 'EGFR', 'BRAF', 'KRAS')."@en .


#################################################################
#    Classes
#################################################################

###  http://hl7.org/fhir/AdverseEvent
<http://hl7.org/fhir/AdverseEvent> rdf:type owl:Class ;
                                   owl:equivalentClass :AdverseEvent ;
                                   rdfs:label "fhir:AdverseEvent" .


###  http://hl7.org/fhir/CarePlan
<http://hl7.org/fhir/CarePlan> rdf:type owl:Class ;
                               owl:equivalentClass :Therapy ;
                               rdfs:label "fhir:CarePlan" .


###  http://hl7.org/fhir/ChargeItem
<http://hl7.org/fhir/ChargeItem> rdf:type owl:Class ;
                                 owl:equivalentClass :Service ;
                                 rdfs:label "fhir:ChargeItem" .


###  http://hl7.org/fhir/Condition
<http://hl7.org/fhir/Condition> rdf:type owl:Class ;
                                rdfs:label "fhir:Condition" .


###  http://hl7.org/fhir/Medication
<http://hl7.org/fhir/Medication> rdf:type owl:Class ;
                                 owl:equivalentClass :ActiveSubstance ;
                                 rdfs:label "fhir:Medication" .


###  http://hl7.org/fhir/MedicationAdministration
<http://hl7.org/fhir/MedicationAdministration> rdf:type owl:Class ;
                                               owl:equivalentClass :Administration ;
                                               rdfs:label "fhir:MedicationAdministration" .


###  http://hl7.org/fhir/Observation
<http://hl7.org/fhir/Observation> rdf:type owl:Class ;
                                  rdfs:label "fhir:Observation" .


###  http://hl7.org/fhir/Organization
<http://hl7.org/fhir/Organization> rdf:type owl:Class ;
                                   owl:equivalentClass :Department ;
                                   rdfs:label "fhir:Organization" .


###  http://hl7.org/fhir/Patient
<http://hl7.org/fhir/Patient> rdf:type owl:Class ;
                              owl:equivalentClass :Patient ;
                              rdfs:label "fhir:Patient" .


###  http://irst.emr.it/cvl/ActiveSubstance
:ActiveSubstance rdf:type owl:Class ;
                 rdfs:label "Active Substance"@en ,
                            "Principio Attivo"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The pharmacologically active ingredient of a medication administered to a patient, identified by its ATC code (e.g., cisplatin, pembrolizumab)."@en .


###  http://irst.emr.it/cvl/AdjuvantTherapy
:AdjuvantTherapy rdf:type owl:Class ;
                 owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15675> ;
                 rdfs:subClassOf :TherapySetting .


###  http://irst.emr.it/cvl/Administration
:Administration rdf:type owl:Class ;
                rdfs:label "Administration"@en ,
                           "Somministrazione"@it ;
                <http://www.w3.org/2004/02/skos/core#definition> "A specific event where a drug, medication, or therapy dose is physically given to the patient at a specific time and date."@en .


###  http://irst.emr.it/cvl/AdvancedTherapy
:AdvancedTherapy rdf:type owl:Class ;
                 rdfs:subClassOf :TherapySetting .


###  http://irst.emr.it/cvl/AdverseEvent
:AdverseEvent rdf:type owl:Class ;
              rdfs:label "Adverse Event"@en ,
                         "Evento avverso"@it ;
              <http://www.w3.org/2004/02/skos/core#definition> "An unfavourable and unintended medical occurrence experienced by a patient following a treatment administration, whether or not considered related to it."@en .


###  http://irst.emr.it/cvl/AdverseEventEffect
:AdverseEventEffect rdf:type owl:Class ;
                    rdfs:subClassOf <http://hl7.org/fhir/Condition> ;
                    rdfs:label "Adverse Event Effect"@en ,
                               "Effetto evento avverso"@it ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The specific type and severity (toxicity grade) of a side effect experienced by the patient (e.g., severe nausea, grade 3 rash)."@en .


###  http://irst.emr.it/cvl/Anxiety
:Anxiety rdf:type owl:Class ;
         rdfs:subClassOf :SymptomAssessmentFinding ;
         rdfs:label "Ansia"@it ,
                    "Anxiety"@en ;
         <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/48694002> ;
         <http://www.w3.org/2004/02/skos/core#definition> "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's anxiety, nervousness or psychological distress on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Biomarker
:Biomarker rdf:type owl:Class ;
           rdfs:subClassOf <http://hl7.org/fhir/Observation> ;
           rdfs:label "Biomarker"@en ,
                      "Biomarker"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "A measurable biological, molecular, or genetic marker tested in the patient's tumor or blood used to guide targeted therapy (e.g., PD-L1, EGFR, HER2)."@en .


###  http://irst.emr.it/cvl/BodyMeasurement
:BodyMeasurement rdf:type owl:Class ;
                 rdfs:subClassOf <http://hl7.org/fhir/Observation> ;
                 rdfs:label "Body Measurement"@en ,
                            "Peso e Altezza"@it ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A record of a patient's physical body metrics (e.g., height, weight) taken on a given date."@en .


###  http://irst.emr.it/cvl/BodyMetric
:BodyMetric rdf:type owl:Class ;
            rdfs:label "Body Metric"@en ,
                       "Metrica corporea"@it ;
            <http://www.w3.org/2004/02/skos/core#definition> "A specific physical measurement value, such as a patient's exact height in centimeters or weight in kilograms."@en .


###  http://irst.emr.it/cvl/BreathingDifficulty
:BreathingDifficulty rdf:type owl:Class ;
                     rdfs:subClassOf :SymptomAssessmentFinding ;
                     rdfs:label "Breathing difficulty"@en ,
                                "Difficoltà a respirare"@it ;
                     <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/267036007> ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's shortness of breath, dyspnea or trouble breathing on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/C_M_Class
:C_M_Class rdf:type owl:Class ;
           owl:equivalentClass <http://snomed.info/sct/399387003> ;
           rdfs:subClassOf :TNMClassificationM ;
           owl:disjointWith :P_M_Class ;
           rdfs:label "Clinical presence of distant metastasis (M)"@en ,
                      "Presenza clinica di metastasi a distanza (M)"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "Clinical Metastasis (cM) category in TNM staging, indicating the presence or absence of distant spread based on clinical imaging before surgery."@en .


###  http://irst.emr.it/cvl/C_N_Class
:C_N_Class rdf:type owl:Class ;
           owl:equivalentClass <http://snomed.info/sct/399534004> ;
           rdfs:subClassOf :TNMClassificationN ;
           owl:disjointWith :P_N_Class ;
           rdfs:label "Clinical spread to regional lymph nodes (N)"@en ,
                      "Coinvolgimento clinico dei linfonodi regionali (N)"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "Clinical Node (cN) category in TNM staging, indicating regional lymph node involvement based on clinical exams before surgery."@en .


###  http://irst.emr.it/cvl/C_T_Class
:C_T_Class rdf:type owl:Class ;
           owl:equivalentClass <http://snomed.info/sct/399504009> ;
           rdfs:subClassOf :TNMClassificationT ;
           owl:disjointWith :P_T_Class ;
           rdfs:label "Clinical tumor size (T)"@en ,
                      "Dimensione del tumore clinica (T)"@it ;
           <http://www.w3.org/2004/02/skos/core#definition> "Clinical Tumor (cT) category in TNM staging, indicating the size and extent of the primary tumor based on clinical exams before surgery."@en .


###  http://irst.emr.it/cvl/ClinicalTNM
:ClinicalTNM rdf:type owl:Class ;
             owl:equivalentClass <http://snomed.info/sct/399537006> ;
             rdfs:subClassOf :TNM ;
             owl:disjointWith :PathologicalTNM ;
             rdfs:label "Clinical TNM"@en ,
                        "TNM clinico"@it ;
             <http://www.w3.org/2004/02/skos/core#definition> "The clinical TNM (Tumor, Node, Metastasis) staging classification, assessed before definitive surgery using imaging and biopsies."@en .


###  http://irst.emr.it/cvl/ConcomitantWithRadiotherapy
:ConcomitantWithRadiotherapy rdf:type owl:Class ;
                             owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94626> ;
                             rdfs:subClassOf :TherapySetting .


###  http://irst.emr.it/cvl/ConsolidationTherapy
:ConsolidationTherapy rdf:type owl:Class ;
                      owl:equivalentClass <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15679> ;
                      rdfs:subClassOf :TherapySetting .


###  http://irst.emr.it/cvl/Department
:Department rdf:type owl:Class ;
            rdfs:label "Department"@en ,
                       "Reparto"@it ;
            <http://www.w3.org/2004/02/skos/core#definition> "A specific hospital unit, clinic, or medical department that provides clinical services or procedures."@en .


###  http://irst.emr.it/cvl/Depression
:Depression rdf:type owl:Class ;
            rdfs:subClassOf :SymptomAssessmentFinding ;
            rdfs:label "Depression"@en ,
                       "Depressione"@it ;
            <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/35489007> ;
            <http://www.w3.org/2004/02/skos/core#definition> "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's depression, sadness or low mood on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/Diagnosis
:Diagnosis rdf:type owl:Class ;
           rdfs:subClassOf <http://hl7.org/fhir/Condition> ;
           rdfs:label "Diagnosi"@it ,
                      "Diagnosis"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The formal medical identification of the patient's cancer, tumor, or disease, including its anatomical primary site and overall stage."@en .


###  http://irst.emr.it/cvl/DrinkerPatient
:DrinkerPatient rdf:type owl:Class ;
                rdfs:subClassOf :Patient ;
                rdfs:label "Drinker patient"@en ,
                           "Paziente consumatore di alcolici"@it ;
                <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/219006> ;
                <http://www.w3.org/2004/02/skos/core#definition> "A patient who has a recorded physiological history of consuming alcohol or being a drinker."@en .


###  http://irst.emr.it/cvl/Drowsiness
:Drowsiness rdf:type owl:Class ;
            rdfs:subClassOf :SymptomAssessmentFinding ;
            rdfs:label "Drowsiness"@en ,
                       "Sonnolenza"@it ;
            <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/271782001> ;
            <http://www.w3.org/2004/02/skos/core#definition> "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's unusual sleepiness or drowsiness on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding
:ECOGPerformanceStatusFinding rdf:type owl:Class ;
                              owl:equivalentClass <http://snomed.info/sct/424122007> ;
                              rdfs:label "ECOG performance status finding"@en ,
                                         "Valore ECOG performance status"@it ;
                              <http://www.w3.org/2004/02/skos/core#definition> "The specific numeric grade (0 through 5) assigned during an ECOG performance status assessment."@en .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding0
:ECOGPerformanceStatusFinding0 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/425389002> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding1
:ECOGPerformanceStatusFinding1 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/422512005> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding2
:ECOGPerformanceStatusFinding2 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/422894000> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding3
:ECOGPerformanceStatusFinding3 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/423053003> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding4
:ECOGPerformanceStatusFinding4 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/423237006> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGPerformanceStatusFinding5
:ECOGPerformanceStatusFinding5 rdf:type owl:Class ;
                               owl:equivalentClass <http://snomed.info/sct/423409001> ;
                               rdfs:subClassOf :ECOGPerformanceStatusFinding .


###  http://irst.emr.it/cvl/ECOGStatus
:ECOGStatus rdf:type owl:Class ;
            rdfs:subClassOf <http://hl7.org/fhir/Observation> ;
            rdfs:label "ECOG Performance Status"@en ,
                       "Stato di performance ECOG"@it ;
            <http://www.w3.org/2004/02/skos/core#definition> "An assessment of a patient's performance status — their level of functioning in terms of self-care, daily activity and physical ability — graded on the Eastern Cooperative Oncology Group (ECOG) scale (0–5)."@en .


###  http://irst.emr.it/cvl/Fatigue
:Fatigue rdf:type owl:Class ;
         rdfs:subClassOf :SymptomAssessmentFinding ;
         rdfs:label "Fatigue"@en ,
                    "Stanchezza"@it ;
         <http://www.w3.org/2004/02/skos/core#closeMatch> <http://snomed.info/sct/84229001> ;
         <http://www.w3.org/2004/02/skos/core#definition> "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's tiredness, exhaustion or fatigue on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."@en .


