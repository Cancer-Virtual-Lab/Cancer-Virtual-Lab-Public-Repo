<?xml version="1.0"?>
<rdf:RDF xmlns="http://irst.emr.it/cvl/"
     xml:base="http://irst.emr.it/cvl/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://irst.emr.it/cvl/">
        <owl:versionIRI rdf:resource="http://irst.emr.it/cvl/1.1.0"/>
        <terms:bibliographicCitation>Giorgetti L, Carbonaro A, Ridolfi L, Pasolini R, Pagliarani A, Cavallucci M, Andalò A, Del Gaudio L, De Angelis P, Vespignani R, Gentili N. Cancer Virtual Lab Ontology (CVL-O), version 1.1.0. Zenodo; 2026. https://doi.org/10.5281/zenodo.23762955</terms:bibliographicCitation>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0066-9172"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-3890-4852"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-3676-171X"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-4148-5954"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0005-8022-0242"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0007-4241-3005"/>
        <terms:contributor>Lorenzo Ridolfi</terms:contributor>
        <terms:contributor>Martina Cavallucci</terms:contributor>
        <terms:contributor>Paolo De Angelis</terms:contributor>
        <terms:contributor>Roberto Pasolini</terms:contributor>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-30</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0009-0002-9475-0744"/>
        <terms:description xml:lang="en">The Cancer Virtual Lab Ontology (CVL-O) is an OWL 2 ontology for representing the oncological care pathway of patients from real-world clinical data: diagnosis and TNM staging, therapies and drug administrations, adverse events, biomarkers, genomic variants, laboratory tests, body measurements, symptom assessments, treatment response and clinical services. It is aligned with HL7 FHIR and reuses standard biomedical terminologies (SNOMED CT, LOINC, NCIt, ICD-10, ATC). CVL-O is the semantic foundation of the Cancer Virtual Lab project, a collaboration between the University of Bologna, IRCCS Istituto Romagnolo per lo Studio dei Tumori (IRST) &quot;Dino Amadori&quot;, Aivolution Srl and IFAB (International Foundation Big Data and Artificial Intelligence for Human Development), and underpins the Cancer Virtual Lab knowledge graph.</terms:description>
        <terms:isPartOf rdf:resource="https://doi.org/10.5281/zenodo.23762955"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</terms:modified>
        <terms:title xml:lang="en">Cancer Virtual Lab Ontology (CVL-O)</terms:title>
        <vann:preferredNamespacePrefix>cvl</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://irst.emr.it/cvl/</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">The clinical definitions (skos:definition) of CVL-O 1.1.0 have been reviewed and validated by the biomedical team of the Cancer Virtual Lab project.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://cancer-virtual-lab.github.io/Cancer-Virtual-Lab-Public-Repo/"/>
        <rdfs:seeAlso rdf:resource="https://github.com/Cancer-Virtual-Lab/Cancer-Virtual-Lab-Public-Repo"/>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/isPartOf -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://irst.emr.it/cvl/TNM_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/TNM_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/TNMClassification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice della classificazione TNM</rdfs:label>
        <rdfs:label xml:lang="en">TNM code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a TNM classification entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/active_substance_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/active_substance_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ActiveSubstance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Active substance code</rdfs:label>
        <rdfs:label xml:lang="it">Codice del principio attivo</rdfs:label>
        <skos:definition xml:lang="en">The specific identifier or code for a drug, medication, or active clinical substance.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/address_diagnosis -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/address_diagnosis">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_addressed_by"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:label xml:lang="en">Address diagnosis</rdfs:label>
        <rdfs:label xml:lang="it">Affronta la diagnosi</rdfs:label>
        <skos:definition xml:lang="en">Relates a therapy, treatment, or clinical management plan to the specific diagnosis or disease it is intended to treat.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/administer_active_substance -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/administer_active_substance">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_administered_in"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Administration"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/ActiveSubstance"/>
        <rdfs:label xml:lang="en">Administer active substance</rdfs:label>
        <rdfs:label xml:lang="it">Somministra principio attivo</rdfs:label>
        <skos:definition xml:lang="en">Links a medical administration event to the specific active substance, drug, medicine, or chemical agent given to the patient.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/adverse_event_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/adverse_event_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEventEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Adverse event code</rdfs:label>
        <rdfs:label xml:lang="it">Codice dell&apos;evento avverso</rdfs:label>
        <skos:definition xml:lang="en">The identifier code for a side effect, toxicity, or adverse medical event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/causes -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/causes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_due_to"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Administration"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/AdverseEvent"/>
        <rdfs:label xml:lang="it">Causa</rdfs:label>
        <rdfs:label xml:lang="en">Causes</rdfs:label>
        <skos:definition xml:lang="en">Indicates that a drug administration is associated with the onset of a specific adverse event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/characterizes_diagnosis -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/characterizes_diagnosis">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_characterized_by"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/TNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:label xml:lang="it">Caratterizza diagnosi</rdfs:label>
        <rdfs:label xml:lang="en">Characterizes diagnosis</rdfs:label>
        <skos:definition xml:lang="en">Links a TNM staging classification to the specific tumor diagnosis it characterizes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/exam_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/exam_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice dell&apos;esame</rdfs:label>
        <rdfs:label xml:lang="en">Exam code</rdfs:label>
        <skos:definition xml:lang="en">The identifier for a genetic variant examination, sequencing, or molecular test.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_ECOG_status -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_ECOG_status">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_ECOG_status_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/ECOGStatus"/>
        <rdfs:label xml:lang="it">Ha ECOG</rdfs:label>
        <rdfs:label xml:lang="en">Has ECOG status</rdfs:label>
        <skos:definition xml:lang="en">Links a patient to an assessment of their ECOG performance status.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_administration -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_administration">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_based_on_therapy"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Administration"/>
        <rdfs:label xml:lang="it">Ha somministrazione</rdfs:label>
        <rdfs:label xml:lang="en">Has administration</rdfs:label>
        <skos:definition xml:lang="en">Links a therapy or treatment plan to the specific dates and events when drugs or medications were administered to the patient.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_biomarker -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_biomarker">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_biomarker_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:label xml:lang="it">Ha biomarker</rdfs:label>
        <rdfs:label xml:lang="en">Has biomarker</rdfs:label>
        <skos:definition xml:lang="en">Connects a patient to a biomarker test, genetic marker finding, or molecular profile result (e.g., PD-L1, HER2).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_body_measurement -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_body_measurement">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_body_measurement_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/BodyMeasurement"/>
        <rdfs:label xml:lang="it">Ha peso e altezza</rdfs:label>
        <rdfs:label xml:lang="en">Has body measurement</rdfs:label>
        <skos:definition xml:lang="en">Links a patient to their physical body measurements, such as their recorded height or weight.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_body_metric -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_body_metric">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_body_metric_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/BodyMeasurement"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/BodyMetric"/>
        <rdfs:label xml:lang="it">Ha metrica corporea</rdfs:label>
        <rdfs:label xml:lang="en">Has body metric</rdfs:label>
        <skos:definition xml:lang="en">Connects a body measurement event to the specific metric recorded (e.g., measuring height or weight).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_cm -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_cm">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_cm_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ClinicalTNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/C_M_Class"/>
        <rdfs:label xml:lang="it">Ha presenza clinica di metastasi a distanza (M)</rdfs:label>
        <rdfs:label xml:lang="en">Has clinical presence of distant metastasis (M)</rdfs:label>
        <skos:definition xml:lang="en">Links a clinical TNM staging record to the clinical Metastasis (cM) classification, indicating distant spread.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_cn -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_cn">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_cn_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ClinicalTNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/C_N_Class"/>
        <rdfs:label xml:lang="it">Ha coinvolgimento clinico dei linfonodi regionali (N)</rdfs:label>
        <rdfs:label xml:lang="en">Has clinical spread to regional lymph nodes (N)</rdfs:label>
        <skos:definition xml:lang="en">Links a clinical TNM staging record to the clinical Node (cN) classification, indicating lymph node involvement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_ct -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_ct">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_ct_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ClinicalTNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/C_T_Class"/>
        <rdfs:label xml:lang="it">Ha dimensione del tumore clinica (T)</rdfs:label>
        <rdfs:label xml:lang="en">Has clinical tumor size (T)</rdfs:label>
        <skos:definition xml:lang="en">Links a clinical TNM staging record to the clinical Tumor (cT) classification, indicating primary tumor size.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_diagnosis -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_diagnosis">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_diagnosis_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:label xml:lang="it">Ha diagnosi</rdfs:label>
        <rdfs:label xml:lang="en">Has diagnosis</rdfs:label>
        <skos:definition xml:lang="en">Links a patient to a cancer diagnosis.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_effect -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_effect">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_adverse_event_effect_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEvent"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/AdverseEventEffect"/>
        <rdfs:label xml:lang="it">Ha effetto</rdfs:label>
        <rdfs:label xml:lang="en">Has effect</rdfs:label>
        <skos:definition xml:lang="en">Links an adverse event to the specific effect, toxicity grade, and description of the side effect experienced.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_gender -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_gender">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/SexAssignedAtBirth"/>
        <rdfs:label xml:lang="it">Ha genere</rdfs:label>
        <rdfs:label xml:lang="en">Has gender</rdfs:label>
        <skos:definition xml:lang="en">Specifies the sex assigned at birth of a patient.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_height -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_height">
        <rdfs:subPropertyOf rdf:resource="http://irst.emr.it/cvl/has_body_metric"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/BodyMeasurement"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Height"/>
        <rdfs:label xml:lang="it">Ha altezza</rdfs:label>
        <rdfs:label xml:lang="en">Has height</rdfs:label>
        <skos:definition xml:lang="en">Links a body measurement event specifically to the patient&apos;s height metric.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_laboratory_test -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_laboratory_test">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_laboratory_test_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:label xml:lang="it">Ha esame di laboratorio</rdfs:label>
        <rdfs:label xml:lang="en">Has laboratory test</rdfs:label>
        <skos:definition xml:lang="en">Connects a patient to blood tests, lab work, hematology, or other laboratory examinations.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_line_of_therapy -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_line_of_therapy">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/LineOfTherapy"/>
        <rdfs:label xml:lang="it">Ha linea di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Has line of therapy</rdfs:label>
        <skos:definition xml:lang="en">Indicates the sequential line of therapy (e.g., first-line, second-line, third-line) for a specific treatment plan.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_physiological_history -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_physiological_history">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_physiological_history_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/PhysiologicalHistory"/>
        <rdfs:label xml:lang="it">Ha anamnesi fisiologica</rdfs:label>
        <rdfs:label xml:lang="en">Has physiological history</rdfs:label>
        <skos:definition xml:lang="en">Links a patient to their lifestyle habits, physiological background, and history such as smoking or alcohol consumption.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_pm -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_pm">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_pm_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/PathologicalTNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/P_M_Class"/>
        <rdfs:label xml:lang="it">Ha presenza patologica di metastasi a distanza (M)</rdfs:label>
        <rdfs:label xml:lang="en">Has pathological presence of distant metastasis (M)</rdfs:label>
        <skos:definition xml:lang="en">Links a pathological TNM staging record to the pathological Metastasis (pM) classification.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/has_pn -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/has_pn">
        <owl:inverseOf rdf:resource="http://irst.emr.it/cvl/is_pn_of"/>
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/PathologicalTNM"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/P_N_Class"/>
        <rdfs:label xml:lang="it">Ha coinvolgimento patologico dei linfonodi regionali (N)</rdfs:label>
        <rdfs:label xml:lang="en">Has pathological spread to regional lymph nodes (N)</rdfs:label>
        <skos:definition xml:lang="en">Links a pathological TNM staging record to the pathological Node (pN) classification.</skos:definition>
    </owl:ObjectProperty>
    


