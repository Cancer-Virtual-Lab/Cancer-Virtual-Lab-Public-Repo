        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNMClassificationT"/>
        <rdfs:label xml:lang="it">Dimensione del tumore patologica (T)</rdfs:label>
        <rdfs:label xml:lang="en">Pathological tumor size (T)</rdfs:label>
        <skos:definition xml:lang="en">Pathological Tumor (pT) category, indicating primary tumor extent and size based on definitive surgical pathology.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Pain -->


