        <rdfs:label xml:lang="en">Malaise</rdfs:label>
        <rdfs:label xml:lang="it">Malessere</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/367391008"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s general feeling of discomfort, illness or unease (lack of wellbeing) on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


