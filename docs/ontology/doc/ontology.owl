    <rdf:Description rdf:about="http://irst.emr.it/cvl/AdjuvantTherapy">
        <rdfs:label xml:lang="en">Adjuvant therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia adiuvante</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting given after the primary treatment (like surgery) to lower the risk that the cancer will return.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/AdvancedTherapy">
        <rdfs:label xml:lang="en">Advanced therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia avanzata</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting for treating advanced, late-stage, or metastatic cancer that has spread.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ConcomitantWithRadiotherapy">
        <rdfs:label xml:lang="en">Concomitant with radiotherapy</rdfs:label>
        <rdfs:label xml:lang="it">Concomitante a radioterapia</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting where systemic treatment (like chemotherapy) is administered concurrently or at the same time as radiation therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ConsolidationTherapy">
        <rdfs:label xml:lang="en">Consolidation therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia di consolidamento</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting given to kill any cancer cells that may be left after initial treatment to deepen the patient&apos;s response.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding0">
        <rdfs:label xml:lang="en">Grade 0</rdfs:label>
        <rdfs:label xml:lang="it">Grado 0</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 0, indicating the patient is fully active and able to carry on all pre-disease performance without restriction.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding1">
        <rdfs:label xml:lang="en">Grade 1</rdfs:label>
        <rdfs:label xml:lang="it">Grado 1</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 1, indicating the patient is restricted in physically strenuous activity but ambulatory.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding2">
        <rdfs:label xml:lang="en">Grade 2</rdfs:label>
        <rdfs:label xml:lang="it">Grado 2</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 2, indicating the patient is ambulatory and capable of all selfcare but unable to carry out any work activities.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding3">
        <rdfs:label xml:lang="en">Grade 3</rdfs:label>
        <rdfs:label xml:lang="it">Grado 3</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 3, indicating the patient is capable of only limited selfcare, confined to bed or chair more than 50% of waking hours.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding4">
        <rdfs:label xml:lang="en">Grade 4</rdfs:label>
        <rdfs:label xml:lang="it">Grado 4</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 4, indicating the patient is completely disabled, cannot carry on any selfcare, and is totally confined to bed or chair.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/ECOGPerformanceStatusFinding5">
        <rdfs:label xml:lang="en">Grade 5</rdfs:label>
        <rdfs:label xml:lang="it">Grado 5</rdfs:label>
        <skos:definition xml:lang="en">ECOG Grade 5, indicating the patient is dead.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/Female">
        <rdfs:label xml:lang="it">Donna</rdfs:label>
        <rdfs:label xml:lang="en">Female</rdfs:label>
        <skos:definition xml:lang="en">Female sex assigned at birth.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/InductionTherapy">
        <rdfs:label xml:lang="en">Induction therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia ad induzione</rdfs:label>
        <skos:definition xml:lang="en">Initial or first-phase therapy setting given to shrink a tumor before other treatments like surgery or radiation.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy1">
        <rdfs:label xml:lang="en">First line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Prima linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">First-line therapy, the initial treatment regimen given for a disease.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy10">
        <rdfs:label xml:lang="it">Decima linea di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Tenth line of therapy</rdfs:label>
        <skos:definition xml:lang="en">Tenth-line therapy, a highly advanced subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy2">
        <rdfs:label xml:lang="en">Second line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Seconda linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Second-line therapy, the treatment given when the first-line therapy doesn&apos;t work or stops working.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy3">
        <rdfs:label xml:lang="it">Terza linea di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Third line of therapy</rdfs:label>
        <skos:definition xml:lang="en">Third-line therapy, given after first- and second-line treatments have failed.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy4">
        <rdfs:label xml:lang="en">Fourth line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Quarta linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Fourth-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy5">
        <rdfs:label xml:lang="en">Fifth line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Quinta linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Fifth-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy6">
        <rdfs:label xml:lang="it">Sesta linea di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Sixth line of therapy</rdfs:label>
        <skos:definition xml:lang="en">Sixth-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy7">
        <rdfs:label xml:lang="it">Settima linea di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Seventh line of therapy</rdfs:label>
        <skos:definition xml:lang="en">Seventh-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy8">
        <rdfs:label xml:lang="en">Eighth line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Ottava linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Eighth-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/LineOfTherapy9">
        <rdfs:label xml:lang="en">Ninth line of therapy</rdfs:label>
        <rdfs:label xml:lang="it">Nona linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Ninth-line therapy, a subsequent treatment regimen.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/MaintenanceTherapy">
        <rdfs:label xml:lang="en">Maintenance therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia di mantenimento</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting intended to help keep cancer from growing after it has shrunk following initial treatment.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/Male">
        <rdfs:label xml:lang="en">Male</rdfs:label>
        <rdfs:label xml:lang="it">Uomo</rdfs:label>
        <skos:definition xml:lang="en">Male sex assigned at birth.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/NeoadjuvantTherapy">
        <rdfs:label xml:lang="en">Neoadjuvant therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia neoadiuvante</rdfs:label>
        <skos:definition xml:lang="en">A therapy setting given before the main treatment (usually surgery) to shrink a tumor and make it easier to remove.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy1">
        <rdfs:label xml:lang="en">First salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Primo salvataggio</rdfs:label>
        <skos:definition xml:lang="en">First-line salvage therapy given for relapsed or refractory disease.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy10">
        <rdfs:label xml:lang="it">Decimo salvataggio</rdfs:label>
        <rdfs:label xml:lang="en">Tenth salvage therapy</rdfs:label>
        <skos:definition xml:lang="en">Tenth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy2">
        <rdfs:label xml:lang="en">Second salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Secondo salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Second-line salvage therapy given for relapsed or refractory disease.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy3">
        <rdfs:label xml:lang="it">Terzo salvataggio</rdfs:label>
        <rdfs:label xml:lang="en">Third salvage therapy</rdfs:label>
        <skos:definition xml:lang="en">Third-line salvage therapy given for relapsed or refractory disease.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy4">
        <rdfs:label xml:lang="en">Fourth salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Quarto salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Fourth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy5">
        <rdfs:label xml:lang="en">Fifth salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Quinto salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Fifth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy6">
        <rdfs:label xml:lang="it">Sesto salvataggio</rdfs:label>
        <rdfs:label xml:lang="en">Sixth salvage therapy</rdfs:label>
        <skos:definition xml:lang="en">Sixth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy7">
        <rdfs:label xml:lang="it">Settimo salvataggio</rdfs:label>
        <rdfs:label xml:lang="en">Seventh salvage therapy</rdfs:label>
        <skos:definition xml:lang="en">Seventh-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy8">
        <rdfs:label xml:lang="en">Eighth salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Ottavo salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Eighth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/SalvageTherapy9">
        <rdfs:label xml:lang="en">Ninth salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Nono salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Ninth-line salvage therapy.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="http://irst.emr.it/cvl/UnknownGender">
        <rdfs:label xml:lang="it">Sconosciuto</rdfs:label>
        <rdfs:label xml:lang="en">Unknown</rdfs:label>
        <skos:definition xml:lang="en">Assigned when the patient&apos;s biological sex is not recorded or known in the system.</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://orcid.org/0000-0002-0066-9172">
        <rdfs:label>Nicola Gentili</rdfs:label>
        <foaf:name>Nicola Gentili</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:about="https://orcid.org/0000-0002-3890-4852">
        <rdfs:label>Antonella Carbonaro</rdfs:label>
        <foaf:name>Antonella Carbonaro</foaf:name>
    </rdf:Description>
    <rdf:Description rdf:about="https://orcid.org/0000-0003-3676-171X">
        <rdfs:label>Roberto Vespignani</rdfs:label>
        <foaf:name>Roberto Vespignani</foaf:name>
    </rdf:Description>
