        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNMClassificationN"/>
        <rdfs:label xml:lang="it">Coinvolgimento patologico dei linfonodi regionali (N)</rdfs:label>
        <rdfs:label xml:lang="en">Pathological spread to regional lymph nodes (N)</rdfs:label>
        <skos:definition xml:lang="en">Pathological Node (pN) category, indicating lymph node spread based on definitive surgical pathology.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/P_T_Class -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/P_T_Class">
