        <skos:closeMatch rdf:resource="http://snomed.info/sct/271782001"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s unusual sleepiness or drowsiness on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


