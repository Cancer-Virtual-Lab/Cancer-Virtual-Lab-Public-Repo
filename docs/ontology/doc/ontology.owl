        <rdfs:label xml:lang="it">Reparto</rdfs:label>
        <skos:definition xml:lang="en">A specific hospital unit, clinic, or medical department that provides clinical services or procedures.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Depression -->


