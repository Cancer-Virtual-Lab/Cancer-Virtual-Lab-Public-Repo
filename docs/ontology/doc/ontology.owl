        <skos:definition xml:lang="en">Reverse link from a genetic mutation or variant back to the patient.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/laboratory_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/laboratory_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice dell’esame</rdfs:label>
        <rdfs:label xml:lang="en">Laboratory code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a specific laboratory test.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/marker_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/marker_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Biomarker code</rdfs:label>
        <rdfs:label xml:lang="it">Codice del biomarker</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a molecular biomarker test.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/marker_value_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/marker_value_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">Biomarker value code</rdfs:label>
        <rdfs:label xml:lang="it">Codice del valore del biomarker</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for the specific value or outcome of a biomarker test.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/provides -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/provides">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Department"/>
        <rdfs:range rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:label xml:lang="it">Eroga</rdfs:label>
        <rdfs:label xml:lang="en">Provides</rdfs:label>
        <skos:definition xml:lang="en">Links a hospital department to the specific clinical services it provides to patients.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/response_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/response_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Response"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice della risposta</rdfs:label>
        <rdfs:label xml:lang="en">Response code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a clinical treatment response finding.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/service_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/service_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Service code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a medical procedure, surgery, or clinical service.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/site_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/site_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice della sede anamnestica</rdfs:label>
        <rdfs:label xml:lang="en">Site code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for the anatomical site, organ, or location of a tumor/diagnosis.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/stage_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/stage_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice stadio della malattia</rdfs:label>
        <rdfs:label xml:lang="en">Disease stage code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for the overall stage of a cancer diagnosis.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://irst.emr.it/cvl/variant_code -->


    <owl:ObjectProperty rdf:about="http://irst.emr.it/cvl/variant_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="it">Codice della variante</rdfs:label>
        <rdfs:label xml:lang="en">Variant code</rdfs:label>
        <skos:definition xml:lang="en">Identifier code for a specific genetic variant or mutation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://irst.emr.it/cvl/ECOG_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/ECOG_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ECOGStatus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data valutazione ECOG</rdfs:label>
        <rdfs:label xml:lang="en">ECOG assessment date</rdfs:label>
        <skos:definition xml:lang="en">The date an ECOG performance status was measured or recorded.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/ESAS_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/ESAS_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/SymptomAssessment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="it">Data della valutazione ESAS</rdfs:label>
        <rdfs:label xml:lang="en">ESAS assessment date</rdfs:label>
        <skos:definition xml:lang="en">The date and time a symptom assessment (ESAS) was completed by the patient.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/TNM_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/TNM_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/TNMClassification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">TNM value</rdfs:label>
        <rdfs:label xml:lang="it">Valore della classificazione TNM</rdfs:label>
        <skos:definition xml:lang="en">The string value representing a TNM classification score (e.g., &apos;T2&apos;, &apos;N1&apos;, &apos;M0&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/active_substance_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/active_substance_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ActiveSubstance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Active substance description</rdfs:label>
        <rdfs:label xml:lang="it">Descrizione del principio attivo</rdfs:label>
        <skos:definition xml:lang="en">The name or textual description of a drug, medication, or active substance (e.g., &apos;Cisplatin&apos;, &apos;Pembrolizumab&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/administration_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/administration_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Administration"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">Administration date</rdfs:label>
        <rdfs:label xml:lang="it">Data di somministrazione</rdfs:label>
        <skos:definition xml:lang="en">The specific date a drug, medication, or therapy was physically administered to the patient.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/adverse_event_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/adverse_event_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">Adverse event date</rdfs:label>
        <rdfs:label xml:lang="it">Data dell’evento avverso</rdfs:label>
        <skos:definition xml:lang="en">The date an adverse event, toxicity, or side effect began.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/adverse_event_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/adverse_event_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEventEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Adverse event description</rdfs:label>
        <rdfs:label xml:lang="it">Descrizione dell&apos;evento avverso</rdfs:label>
        <skos:definition xml:lang="en">The text description of a side effect or adverse event (e.g., &apos;Nausea&apos;, &apos;Neutropenia&apos;, &apos;Rash&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/alcohol_consumption -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/alcohol_consumption">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/PhysiologicalHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">Alcohol consumption</rdfs:label>
        <rdfs:label xml:lang="it">Consumo di alcol</rdfs:label>
        <skos:definition xml:lang="en">Boolean flag (true/false) indicating whether the patient consumes alcohol (is a drinker).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/amino_acid_change -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/amino_acid_change">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Amino acid change</rdfs:label>
        <rdfs:label xml:lang="it">Cambiamento aminoacidico</rdfs:label>
        <skos:definition xml:lang="en">The specific protein or amino acid change caused by a genetic variant (e.g., &apos;V600E&apos;, &apos;L858R&apos;).</skos:definition>
        <skos:exactMatch rdf:resource="http://snomed.info/sct/250574005"/>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/birth_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/birth_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">Birth date</rdfs:label>
        <rdfs:label xml:lang="it">Data di nascita</rdfs:label>
        <skos:definition xml:lang="en">The patient&apos;s date of birth. Used to calculate their age.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/body_metric_unit -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/body_metric_unit">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/BodyMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Body metric unit</rdfs:label>
        <rdfs:label xml:lang="it">Unità di misura metrica</rdfs:label>
        <skos:definition xml:lang="en">The unit of measure of a body metric value (e.g., &apos;cm&apos;, &apos;kg&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/body_metric_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/body_metric_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/BodyMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">Body metric value</rdfs:label>
        <rdfs:label xml:lang="it">Valore metrica</rdfs:label>
        <skos:definition xml:lang="en">The numeric integer value of a body measurement (e.g., height in cm, weight in kg).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/category1 -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/category1">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Categoria 1 della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Category 1</rdfs:label>
        <skos:definition xml:lang="en">Primary hierarchical classification category for a clinical service or procedure.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/category2 -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/category2">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Categoria 2 della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Category 2</rdfs:label>
        <skos:definition xml:lang="en">Secondary hierarchical classification category for a clinical service or procedure.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/category3 -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/category3">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Categoria 3 della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Category 3</rdfs:label>
        <skos:definition xml:lang="en">Tertiary hierarchical classification category for a clinical service or procedure.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/currency -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/currency">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Currency</rdfs:label>
        <rdfs:label xml:lang="it">Valuta della prestazione</rdfs:label>
        <skos:definition xml:lang="en">The currency used to denominate the price of a clinical service (e.g., &apos;EUR&apos;, &apos;USD&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/death_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/death_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data di morte</rdfs:label>
        <rdfs:label xml:lang="en">Death date</rdfs:label>
        <skos:definition xml:lang="en">The date of the patient&apos;s death. Used for calculating overall survival and mortality.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/department_code -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/department_code">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Department"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Codice del reparto</rdfs:label>
        <rdfs:label xml:lang="en">Department code</rdfs:label>
        <skos:definition xml:lang="en">Alphanumeric identifier code for a hospital department.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/department_name -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/department_name">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Department"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Department name</rdfs:label>
        <rdfs:label xml:lang="it">Nome del reparto</rdfs:label>
        <skos:definition xml:lang="en">The name of the hospital department providing a clinical service (e.g., &apos;Oncology&apos;, &apos;Radiology&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/diagnosis_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/diagnosis_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data della diagnosi</rdfs:label>
        <rdfs:label xml:lang="en">Diagnosis date</rdfs:label>
        <skos:definition xml:lang="en">The date the cancer, tumor, or disease was formally diagnosed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/exam_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/exam_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione dell&apos;esame</rdfs:label>
        <rdfs:label xml:lang="en">Exam description</rdfs:label>
        <skos:definition xml:lang="en">Description of the genetic, genomic, or molecular examination performed to find a variant.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/first_administration_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/first_administration_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data della prima somministrazione della terapia</rdfs:label>
        <rdfs:label xml:lang="en">First administration date</rdfs:label>
        <skos:definition xml:lang="en">The start date when a patient received the very first dose of a specific line of therapy.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/laboratory_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/laboratory_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione dell’esame</rdfs:label>
        <rdfs:label xml:lang="en">Laboratory description</rdfs:label>
        <skos:definition xml:lang="en">The name or description of a lab test (e.g., &apos;Hemoglobin&apos;, &apos;White Blood Cell Count&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/laboratory_test_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/laboratory_test_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data dell’esame di laboratorio</rdfs:label>
        <rdfs:label xml:lang="en">Laboratory test date</rdfs:label>
        <skos:definition xml:lang="en">The date a blood test or laboratory exam was drawn or performed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/last_administration_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/last_administration_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data dell’ultima somministrazione della terapia</rdfs:label>
        <rdfs:label xml:lang="en">Last administration date</rdfs:label>
        <skos:definition xml:lang="en">The end date when a patient received their final dose of a specific line of therapy.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/line_of_therapy_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/line_of_therapy_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">Line of therapy value</rdfs:label>
        <rdfs:label xml:lang="it">Valore linea di terapia</rdfs:label>
        <skos:definition xml:lang="en">Numeric integer indicating the sequential line of treatment (1 for first-line, 2 for second-line, etc.).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/marker_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/marker_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="en">Biomarker measurement date</rdfs:label>
        <rdfs:label xml:lang="it">Data della misurazione del biomarker</rdfs:label>
        <skos:definition xml:lang="en">The date a biomarker test or molecular profiling was performed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/marker_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/marker_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Biomarker description</rdfs:label>
        <rdfs:label xml:lang="it">Descrizione del biomarker</rdfs:label>
        <skos:definition xml:lang="en">The name of the biomarker tested (e.g., &apos;PD-L1&apos;, &apos;HER2&apos;, &apos;ALK&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/marker_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/marker_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Biomarker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Biomarker value</rdfs:label>
        <rdfs:label xml:lang="it">Valore del biomarker</rdfs:label>
        <skos:definition xml:lang="en">The result or status of a biomarker test (e.g., &apos;Positive&apos;, &apos;Negative&apos;, &apos;50% expression&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/measurement_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/measurement_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/BodyMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data della misurazione</rdfs:label>
        <rdfs:label xml:lang="en">Measurement date</rdfs:label>
        <skos:definition xml:lang="en">The date a patient&apos;s body measurement (height or weight) was recorded.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/patient_identifier -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/patient_identifier">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Identificativo del paziente</rdfs:label>
        <rdfs:label xml:lang="en">Patient identifier</rdfs:label>
        <skos:definition xml:lang="en">The unique alphanumeric ID code or medical record number of a patient.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/price -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/price">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="it">Prezzo della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Price</rdfs:label>
        <skos:definition xml:lang="en">The financial cost, billing amount, or price of a medical service or procedure.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/quantity -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/quantity">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Quantity</rdfs:label>
        <rdfs:label xml:lang="it">Quantità erogata</rdfs:label>
        <skos:definition xml:lang="en">The count or number of times a specific service or procedure was performed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/reference_max_unit -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/reference_max_unit">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Maximum reference unit</rdfs:label>
        <rdfs:label xml:lang="it">Unità del valore massimo di riferimento</rdfs:label>
        <skos:definition xml:lang="en">The unit of measurement for a lab test&apos;s maximum normal value.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/reference_max_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/reference_max_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Maximum reference value</rdfs:label>
        <rdfs:label xml:lang="it">Valore massimo di riferimento</rdfs:label>
        <skos:definition xml:lang="en">The upper limit of the normal reference range for a laboratory test.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/reference_min_unit -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/reference_min_unit">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Minimum reference unit</rdfs:label>
        <rdfs:label xml:lang="it">Unità del valore minimo di riferimento</rdfs:label>
        <skos:definition xml:lang="en">The unit of measurement for a lab test&apos;s minimum normal value.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/reference_min_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/reference_min_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/LaboratoryTest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Minimum reference value</rdfs:label>
        <rdfs:label xml:lang="it">Valore minimo di riferimento</rdfs:label>
        <skos:definition xml:lang="en">The lower limit of the normal reference range for a laboratory test.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/response_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/response_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Response"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data della risposta</rdfs:label>
        <rdfs:label xml:lang="en">Response date</rdfs:label>
        <skos:definition xml:lang="en">The date a clinical response evaluation or tumor restaging was recorded.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/response_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/response_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Response"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione della risposta</rdfs:label>
        <rdfs:label xml:lang="en">Response description</rdfs:label>
        <skos:definition xml:lang="en">Free-text description of a clinical response assessment as reported in the source record.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/response_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/response_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Response"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Response value</rdfs:label>
        <rdfs:label xml:lang="it">Valore della risposta</rdfs:label>
        <skos:definition xml:lang="en">The clinical outcome or tumor response to therapy (e.g., &apos;Complete Response&apos;, &apos;Progressive Disease&apos;, &apos;Stable Disease&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/service_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/service_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data di erogazione della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Service date</rdfs:label>
        <skos:definition xml:lang="en">The date a clinical service, imaging scan, or procedure was provided.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/service_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/service_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione della prestazione</rdfs:label>
        <rdfs:label xml:lang="en">Service description</rdfs:label>
        <skos:definition xml:lang="en">The text description of a medical procedure, imaging scan, surgery, or clinical service.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/site_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/site_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione della sede anamnestica</rdfs:label>
        <rdfs:label xml:lang="en">Site description</rdfs:label>
        <skos:definition xml:lang="en">The anatomical site, organ, or bodily location where the primary tumor or cancer is located (e.g., &apos;Lung&apos;, &apos;Breast&apos;, &apos;Colon&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/smoking -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/smoking">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/PhysiologicalHistory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="it">Fumo</rdfs:label>
        <rdfs:label xml:lang="en">Smoking</rdfs:label>
        <skos:definition xml:lang="en">Boolean flag (true/false) indicating whether the patient is a smoker or uses tobacco.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/stage_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/stage_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Diagnosis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione dello stadio della malattia</rdfs:label>
        <rdfs:label xml:lang="en">Disease stage description</rdfs:label>
        <skos:definition xml:lang="en">The overall clinical or pathological stage of the cancer (e.g., &apos;Stage IIIA&apos;, &apos;Stage IV&apos;, &apos;Metastatic&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/symptom_assessment_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/symptom_assessment_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/SymptomAssessmentFinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">Symptom assessment value</rdfs:label>
        <rdfs:label xml:lang="it">Valore valutazione dei sintomi</rdfs:label>
        <skos:definition xml:lang="en">The numeric severity score (usually 0-10) for a specific patient-reported symptom (pain, fatigue, nausea, etc.).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/target_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/target_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/ECOGStatus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione del target</rdfs:label>
        <rdfs:label xml:lang="en">Target description</rdfs:label>
        <skos:definition xml:lang="en">The text description of the patient&apos;s ECOG performance status (e.g., &apos;Fully active&apos;, &apos;Restricted in physically strenuous activity&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/toxicity_grade_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/toxicity_grade_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEventEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione del grado di tossicità</rdfs:label>
        <rdfs:label xml:lang="en">Toxicity grade description</rdfs:label>
        <skos:definition xml:lang="en">Text description of the severity of an adverse event or side effect.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/toxicity_grade_value -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/toxicity_grade_value">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/AdverseEventEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">Toxicity grade value</rdfs:label>
        <rdfs:label xml:lang="it">Valore del grado di tossicità</rdfs:label>
        <skos:definition xml:lang="en">Numeric grade (usually 1-5) indicating the severity of an adverse event or clinical toxicity.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/variant2 -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/variant2">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Seconda variante</rdfs:label>
        <rdfs:label xml:lang="en">Variant 2</rdfs:label>
        <skos:definition xml:lang="en">Additional molecular information or secondary classification about a genetic variant.</skos:definition>
        <skos:exactMatch rdf:resource="http://snomed.info/sct/64195000"/>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/variant_date -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/variant_date">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label xml:lang="it">Data della variante</rdfs:label>
        <rdfs:label xml:lang="en">Variant date</rdfs:label>
        <skos:definition xml:lang="en">The date a genetic variant or mutation was sequenced or detected.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://irst.emr.it/cvl/variant_description -->


    <owl:DatatypeProperty rdf:about="http://irst.emr.it/cvl/variant_description">
        <rdfs:domain rdf:resource="http://irst.emr.it/cvl/Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="it">Descrizione della variante</rdfs:label>
        <rdfs:label xml:lang="en">Variant description</rdfs:label>
        <skos:definition xml:lang="en">The name or gene of the detected mutation, variant, or genetic alteration (e.g., &apos;EGFR&apos;, &apos;BRAF&apos;, &apos;KRAS&apos;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://hl7.org/fhir/AdverseEvent -->


    <owl:Class rdf:about="http://hl7.org/fhir/AdverseEvent">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/AdverseEvent"/>
        <rdfs:label>fhir:AdverseEvent</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/CarePlan -->


    <owl:Class rdf:about="http://hl7.org/fhir/CarePlan">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/Therapy"/>
        <rdfs:label>fhir:CarePlan</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/ChargeItem -->


    <owl:Class rdf:about="http://hl7.org/fhir/ChargeItem">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/Service"/>
        <rdfs:label>fhir:ChargeItem</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/Condition -->


    <owl:Class rdf:about="http://hl7.org/fhir/Condition">
        <rdfs:label>fhir:Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/Medication -->


    <owl:Class rdf:about="http://hl7.org/fhir/Medication">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/ActiveSubstance"/>
        <rdfs:label>fhir:Medication</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/MedicationAdministration -->


    <owl:Class rdf:about="http://hl7.org/fhir/MedicationAdministration">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/Administration"/>
        <rdfs:label>fhir:MedicationAdministration</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/Observation -->


    <owl:Class rdf:about="http://hl7.org/fhir/Observation">
        <rdfs:label>fhir:Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/Organization -->


    <owl:Class rdf:about="http://hl7.org/fhir/Organization">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/Department"/>
        <rdfs:label>fhir:Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/Patient -->


    <owl:Class rdf:about="http://hl7.org/fhir/Patient">
        <owl:equivalentClass rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:label>fhir:Patient</rdfs:label>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/ActiveSubstance -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/ActiveSubstance">
        <rdfs:label xml:lang="en">Active Substance</rdfs:label>
        <rdfs:label xml:lang="it">Principio Attivo</rdfs:label>
        <skos:definition xml:lang="en">The pharmacologically active ingredient of a medication administered to a patient, identified by its ATC code (e.g., cisplatin, pembrolizumab).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/AdjuvantTherapy -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/AdjuvantTherapy">
        <owl:equivalentClass rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15675"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TherapySetting"/>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Administration -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Administration">
        <rdfs:label xml:lang="en">Administration</rdfs:label>
        <rdfs:label xml:lang="it">Somministrazione</rdfs:label>
        <skos:definition xml:lang="en">A specific event where a drug, medication, or therapy dose is physically given to the patient at a specific time and date.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/AdvancedTherapy -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/AdvancedTherapy">
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TherapySetting"/>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/AdverseEvent -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/AdverseEvent">
        <rdfs:label xml:lang="en">Adverse Event</rdfs:label>
        <rdfs:label xml:lang="it">Evento avverso</rdfs:label>
        <skos:definition xml:lang="en">An unfavourable and unintended medical occurrence experienced by a patient following a treatment administration, whether or not considered related to it.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/AdverseEventEffect -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/AdverseEventEffect">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Condition"/>
        <rdfs:label xml:lang="en">Adverse Event Effect</rdfs:label>
        <rdfs:label xml:lang="it">Effetto evento avverso</rdfs:label>
        <skos:definition xml:lang="en">The specific type and severity (toxicity grade) of a side effect experienced by the patient (e.g., severe nausea, grade 3 rash).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Anxiety -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Anxiety">
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/SymptomAssessmentFinding"/>
        <rdfs:label xml:lang="it">Ansia</rdfs:label>
        <rdfs:label xml:lang="en">Anxiety</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/48694002"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s anxiety, nervousness or psychological distress on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Biomarker -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Biomarker">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">Biomarker</rdfs:label>
        <rdfs:label xml:lang="it">Biomarker</rdfs:label>
        <skos:definition xml:lang="en">A measurable biological, molecular, or genetic marker tested in the patient&apos;s tumor or blood used to guide targeted therapy (e.g., PD-L1, EGFR, HER2).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/BodyMeasurement -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/BodyMeasurement">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">Body Measurement</rdfs:label>
        <rdfs:label xml:lang="it">Peso e Altezza</rdfs:label>
        <skos:definition xml:lang="en">A record of a patient&apos;s physical body metrics (e.g., height, weight) taken on a given date.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/BodyMetric -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/BodyMetric">
        <rdfs:label xml:lang="en">Body Metric</rdfs:label>
        <rdfs:label xml:lang="it">Metrica corporea</rdfs:label>
        <skos:definition xml:lang="en">A specific physical measurement value, such as a patient&apos;s exact height in centimeters or weight in kilograms.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/BreathingDifficulty -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/BreathingDifficulty">
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/SymptomAssessmentFinding"/>
        <rdfs:label xml:lang="en">Breathing difficulty</rdfs:label>
        <rdfs:label xml:lang="it">Difficoltà a respirare</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/267036007"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s shortness of breath, dyspnea or trouble breathing on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/C_M_Class -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/C_M_Class">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/399387003"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNMClassificationM"/>
        <owl:disjointWith rdf:resource="http://irst.emr.it/cvl/P_M_Class"/>
        <rdfs:label xml:lang="en">Clinical presence of distant metastasis (M)</rdfs:label>
        <rdfs:label xml:lang="it">Presenza clinica di metastasi a distanza (M)</rdfs:label>
        <skos:definition xml:lang="en">Clinical Metastasis (cM) category in TNM staging, indicating the presence or absence of distant spread based on clinical imaging before surgery.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/C_N_Class -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/C_N_Class">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/399534004"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNMClassificationN"/>
        <owl:disjointWith rdf:resource="http://irst.emr.it/cvl/P_N_Class"/>
        <rdfs:label xml:lang="en">Clinical spread to regional lymph nodes (N)</rdfs:label>
        <rdfs:label xml:lang="it">Coinvolgimento clinico dei linfonodi regionali (N)</rdfs:label>
        <skos:definition xml:lang="en">Clinical Node (cN) category in TNM staging, indicating regional lymph node involvement based on clinical exams before surgery.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/C_T_Class -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/C_T_Class">
