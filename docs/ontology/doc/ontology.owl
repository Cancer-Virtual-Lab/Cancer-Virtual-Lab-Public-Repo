        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">Response</rdfs:label>
        <rdfs:label xml:lang="it">Risposta al trattamento</rdfs:label>
        <skos:definition xml:lang="en">The clinical outcome, treatment effect, or restaging result measuring how well the tumor responded to therapy (e.g., progressive disease, stable disease, complete response).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/SalvageTherapy -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/SalvageTherapy">
        <owl:equivalentClass rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15359"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TherapySetting"/>
        <rdfs:label xml:lang="en">Salvage therapy</rdfs:label>
        <rdfs:label xml:lang="it">Terapia di salvataggio</rdfs:label>
        <skos:definition xml:lang="en">Therapy setting given when the cancer has not responded to other treatments or has returned (relapse/refractory settings).</skos:definition>
    </owl:Class>
    


