        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNMClassificationM"/>
        <rdfs:label xml:lang="en">Pathological presence of distant metastasis (M)</rdfs:label>
        <rdfs:label xml:lang="it">Presenza patologica di metastasi a distanza (M)</rdfs:label>
        <skos:definition xml:lang="en">Pathological Metastasis (pM) category, determining distant spread after examining surgical tissue under a microscope.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/P_N_Class -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/P_N_Class">
