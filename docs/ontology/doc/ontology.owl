    <!-- http://irst.emr.it/cvl/Service -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Service">
        <rdfs:label xml:lang="en">Clinical Service</rdfs:label>
        <rdfs:label xml:lang="it">Prestazione Clinica</rdfs:label>
        <skos:definition xml:lang="en">A clinical service or procedure (e.g., imaging, surgery, outpatient visit) provided to a patient by a hospital department.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/SexAssignedAtBirth -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/SexAssignedAtBirth">
        <owl:equivalentClass rdf:resource="https://loinc.org/76689-9"/>
        <rdfs:label xml:lang="it">Sesso assegnato alla nascita</rdfs:label>
        <rdfs:label xml:lang="en">Sex assigned at birth</rdfs:label>
        <skos:definition xml:lang="en">The sex assigned to a patient at birth (e.g., male, female).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/SmokerPatient -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/SmokerPatient">
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/Patient"/>
        <rdfs:label xml:lang="it">Paziente fumatore</rdfs:label>
        <rdfs:label xml:lang="en">Smoker patient</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/77176002"/>
        <skos:definition xml:lang="en">A patient who has a recorded physiological history of smoking, tobacco use, or nicotine addiction.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/SymptomAssessment -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/SymptomAssessment">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">Symptom Assessment</rdfs:label>
        <rdfs:label xml:lang="it">Valutazione dei sintomi</rdfs:label>
        <skos:definition xml:lang="en">An Edmonton Symptom Assessment System (ESAS) survey evaluating the patient&apos;s palliative symptoms, pain, and quality of life.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/SymptomAssessmentFinding -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/SymptomAssessmentFinding">
        <rdfs:label xml:lang="it">Rilevazione dei sintomi manifestati</rdfs:label>
        <rdfs:label xml:lang="en">Symptom Assessment finding</rdfs:label>
        <skos:definition xml:lang="en">A specific subjective symptom reported in an ESAS survey along with its severity score (e.g., Pain=8).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TNM -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TNM">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/399390009"/>
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">TNM</rdfs:label>
        <rdfs:label xml:lang="it">TNM</rdfs:label>
        <skos:definition xml:lang="en">A general representation of the Tumor, Node, Metastasis (TNM) oncology staging system used to describe the extent of cancer.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TNMClassification -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TNMClassification">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/399566009"/>
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="it">Classificazione TNM</rdfs:label>
        <rdfs:label xml:lang="en">TNM Classification</rdfs:label>
        <skos:definition xml:lang="en">An overarching classification category for any specific T (Tumor), N (Node), or M (Metastasis) staging score.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TNMClassificationM -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TNMClassificationM">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/277208005"/>
        <rdfs:subClassOf rdf:resource="http://snomed.info/sct/399566009"/>
        <rdfs:label xml:lang="it">Categoria M</rdfs:label>
        <rdfs:label xml:lang="en">M category</rdfs:label>
        <skos:definition xml:lang="en">The parent class for Metastasis (M) staging categories, indicating distant cancer spread.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TNMClassificationN -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TNMClassificationN">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/277206009"/>
        <rdfs:subClassOf rdf:resource="http://snomed.info/sct/399566009"/>
        <rdfs:label xml:lang="it">Categoria N</rdfs:label>
        <rdfs:label xml:lang="en">N category</rdfs:label>
        <skos:definition xml:lang="en">The parent class for Node (N) staging categories, indicating regional lymph node involvement.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TNMClassificationT -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TNMClassificationT">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/78873005"/>
        <rdfs:subClassOf rdf:resource="http://snomed.info/sct/399566009"/>
        <rdfs:label xml:lang="it">Categoria T</rdfs:label>
        <rdfs:label xml:lang="en">T category</rdfs:label>
        <skos:definition xml:lang="en">The parent class for Tumor (T) staging categories, indicating primary tumor size and local extent.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Therapy -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Therapy">
        <rdfs:label xml:lang="it">Terapia</rdfs:label>
        <rdfs:label xml:lang="en">Therapy</rdfs:label>
        <skos:definition xml:lang="en">A treatment plan or oncological regimen (e.g., chemotherapy, immunotherapy, targeted therapy) administered to a patient over a period of time.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/TherapySetting -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/TherapySetting">
        <rdfs:label xml:lang="it">Setting di terapia</rdfs:label>
        <rdfs:label xml:lang="en">Therapy setting</rdfs:label>
        <skos:definition xml:lang="en">The clinical context, timing, or intent of the cancer therapy (e.g., adjuvant, palliative, induction, neoadjuvant).</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/UnknownGender -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/UnknownGender">
        <owl:equivalentClass rdf:resource="https://loinc.org/LA4489-6"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/SexAssignedAtBirth"/>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Variant -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Variant">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/Observation"/>
        <rdfs:label xml:lang="en">Variant</rdfs:label>
        <rdfs:label xml:lang="it">Variante genetica</rdfs:label>
        <skos:definition xml:lang="en">A genetic mutation, genomic alteration, or molecular DNA variant found in the patient&apos;s tumor profiling or NGS sequencing.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Weight -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Weight">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/363808001"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/BodyMetric"/>
        <rdfs:label xml:lang="it">Peso</rdfs:label>
        <rdfs:label xml:lang="en">Weight</rdfs:label>
        <skos:definition xml:lang="en">A specific body metric recording the patient&apos;s body mass, usually measured in kilograms.</skos:definition>
    </owl:Class>
    


