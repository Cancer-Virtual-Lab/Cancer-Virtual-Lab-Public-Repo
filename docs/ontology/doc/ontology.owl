        <rdfs:label xml:lang="en">Diagnosis</rdfs:label>
        <skos:definition xml:lang="en">The formal medical identification of the patient&apos;s cancer, tumor, or disease, including its anatomical primary site and overall stage.</skos:definition>
    </owl:Class>
    


