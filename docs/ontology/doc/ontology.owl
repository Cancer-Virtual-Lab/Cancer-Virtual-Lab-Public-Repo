        <rdfs:label xml:lang="it">Nausea</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/422587007"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s nausea or urge to vomit on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


