        <rdfs:label xml:lang="it">Dolore</rdfs:label>
        <rdfs:label xml:lang="en">Pain</rdfs:label>
        <skos:closeMatch rdf:resource="http://snomed.info/sct/22253000"/>
        <skos:definition xml:lang="en">An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient&apos;s physical pain on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/PathologicalTNM -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/PathologicalTNM">
        <owl:equivalentClass rdf:resource="http://snomed.info/sct/399588009"/>
        <rdfs:subClassOf rdf:resource="http://irst.emr.it/cvl/TNM"/>
        <rdfs:label xml:lang="en">Pathological TNM</rdfs:label>
        <rdfs:label xml:lang="it">TNM patologico</rdfs:label>
        <skos:definition xml:lang="en">The pathological TNM staging classification, which is the most accurate staging determined after surgical removal and lab examination of the tumor.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Patient -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/Patient">
        <rdfs:label xml:lang="en">Patient</rdfs:label>
        <rdfs:label xml:lang="it">Paziente</rdfs:label>
        <skos:definition xml:lang="en">The core individual person receiving clinical care, diagnosed with cancer, and undergoing oncological therapies.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/PhysiologicalHistory -->


