        <owl:disjointWith rdf:resource="http://irst.emr.it/cvl/P_T_Class"/>
        <rdfs:label xml:lang="en">Clinical tumor size (T)</rdfs:label>
        <rdfs:label xml:lang="it">Dimensione del tumore clinica (T)</rdfs:label>
        <skos:definition xml:lang="en">Clinical Tumor (cT) category in TNM staging, indicating the size and extent of the primary tumor based on clinical exams before surgery.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/ClinicalTNM -->


    <owl:Class rdf:about="http://irst.emr.it/cvl/ClinicalTNM">
