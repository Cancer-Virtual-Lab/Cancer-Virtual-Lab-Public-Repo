        <rdfs:label xml:lang="it">TNM clinico</rdfs:label>
        <skos:definition xml:lang="en">The clinical TNM (Tumor, Node, Metastasis) staging classification, assessed before definitive surgery using imaging and biopsies.</skos:definition>
    </owl:Class>
    


