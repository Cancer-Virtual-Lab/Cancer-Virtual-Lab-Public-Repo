        <rdfs:label xml:lang="it">Anamnesi Fisiologica</rdfs:label>
        <rdfs:label xml:lang="en">Physiological History</rdfs:label>
        <skos:definition xml:lang="en">The patient&apos;s lifestyle habits, physiological background, and personal history, notably including smoking and alcohol use.</skos:definition>
    </owl:Class>
    


    <!-- http://irst.emr.it/cvl/Response -->


