}, {
  "@id" : "http://irst.emr.it/cvl/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Giorgetti L, Carbonaro A, Ridolfi L, Pasolini R, Pagliarani A, Cavallucci M, Andalò A, Del Gaudio L, De Angelis P, Vespignani R, Gentili N. Cancer Virtual Lab Ontology (CVL-O), version 1.1.0. Zenodo; 2026. https://doi.org/10.5281/zenodo.23762955"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@id" : "https://orcid.org/0000-0002-0066-9172"
  }, {
    "@id" : "https://orcid.org/0000-0002-3890-4852"
  }, {
    "@id" : "https://orcid.org/0000-0003-3676-171X"
  }, {
    "@id" : "https://orcid.org/0009-0000-4148-5954"
  }, {
    "@id" : "https://orcid.org/0009-0005-8022-0242"
  }, {
    "@id" : "https://orcid.org/0009-0007-4241-3005"
  }, {
    "@value" : "Lorenzo Ridolfi"
  }, {
    "@value" : "Martina Cavallucci"
  }, {
    "@value" : "Paolo De Angelis"
  }, {
    "@value" : "Roberto Pasolini"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-01-30"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0009-0002-9475-0744"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The Cancer Virtual Lab Ontology (CVL-O) is an OWL 2 ontology for representing the oncological care pathway of patients from real-world clinical data: diagnosis and TNM staging, therapies and drug administrations, adverse events, biomarkers, genomic variants, laboratory tests, body measurements, symptom assessments, treatment response and clinical services. It is aligned with HL7 FHIR and reuses standard biomedical terminologies (SNOMED CT, LOINC, NCIt, ICD-10, ATC). CVL-O is the semantic foundation of the Cancer Virtual Lab project, a collaboration between the University of Bologna, IRCCS Istituto Romagnolo per lo Studio dei Tumori (IRST) \"Dino Amadori\", Aivolution Srl and IFAB (International Foundation Big Data and Artificial Intelligence for Human Development), and underpins the Cancer Virtual Lab knowledge graph."
  } ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://doi.org/10.5281/zenodo.23762955"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-10-30"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Cancer Virtual Lab Ontology (CVL-O)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "cvl"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "http://irst.emr.it/cvl/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The clinical definitions (skos:definition) of CVL-O 1.1.0 have been reviewed and validated by the biomedical team of the Cancer Virtual Lab project."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://cancer-virtual-lab.github.io/Cancer-Virtual-Lab-Public-Repo/"
  }, {
    "@id" : "https://github.com/Cancer-Virtual-Lab/Cancer-Virtual-Lab-Public-Repo"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://irst.emr.it/cvl/1.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.1.0"
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/ActiveSubstance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Active Substance"
  }, {
    "@language" : "it",
    "@value" : "Principio Attivo"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The pharmacologically active ingredient of a medication administered to a patient, identified by its ATC code (e.g., cisplatin, pembrolizumab)."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/AdjuvantTherapy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://irst.emr.it/cvl/AdjuvantTherapy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Adjuvant therapy"
  }, {
    "@language" : "it",
    "@value" : "Terapia adiuvante"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/TherapySetting"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C15675"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A therapy setting given after the primary treatment (like surgery) to lower the risk that the cancer will return."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/Administration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Administration"
  }, {
    "@language" : "it",
    "@value" : "Somministrazione"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific event where a drug, medication, or therapy dose is physically given to the patient at a specific time and date."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/AdvancedTherapy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://irst.emr.it/cvl/AdvancedTherapy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Advanced therapy"
  }, {
    "@language" : "it",
    "@value" : "Terapia avanzata"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/TherapySetting"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A therapy setting for treating advanced, late-stage, or metastatic cancer that has spread."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/AdverseEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Adverse Event"
  }, {
    "@language" : "it",
    "@value" : "Evento avverso"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An unfavourable and unintended medical occurrence experienced by a patient following a treatment administration, whether or not considered related to it."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/AdverseEventEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Adverse Event Effect"
  }, {
    "@language" : "it",
    "@value" : "Effetto evento avverso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://hl7.org/fhir/Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The specific type and severity (toxicity grade) of a side effect experienced by the patient (e.g., severe nausea, grade 3 rash)."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/Anxiety",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "it",
    "@value" : "Ansia"
  }, {
    "@language" : "en",
    "@value" : "Anxiety"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/SymptomAssessmentFinding"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://snomed.info/sct/48694002"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's anxiety, nervousness or psychological distress on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/Biomarker",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Biomarker"
  }, {
    "@language" : "it",
    "@value" : "Biomarker"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://hl7.org/fhir/Observation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A measurable biological, molecular, or genetic marker tested in the patient's tumor or blood used to guide targeted therapy (e.g., PD-L1, EGFR, HER2)."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/BodyMeasurement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Body Measurement"
  }, {
    "@language" : "it",
    "@value" : "Peso e Altezza"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://hl7.org/fhir/Observation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A record of a patient's physical body metrics (e.g., height, weight) taken on a given date."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/BodyMetric",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Body Metric"
  }, {
    "@language" : "it",
    "@value" : "Metrica corporea"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific physical measurement value, such as a patient's exact height in centimeters or weight in kilograms."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/BreathingDifficulty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Breathing difficulty"
  }, {
    "@language" : "it",
    "@value" : "Difficoltà a respirare"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/SymptomAssessmentFinding"
  } ],
  "http://www.w3.org/2004/02/skos/core#closeMatch" : [ {
    "@id" : "http://snomed.info/sct/267036007"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An item of an ESAS (Edmonton Symptom Assessment System) survey rating the patient's shortness of breath, dyspnea or trouble breathing on a 0-10 scale (0 = absent, 10 = worst possible); the item is recorded whatever its score."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/C_M_Class",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Clinical presence of distant metastasis (M)"
  }, {
    "@language" : "it",
    "@value" : "Presenza clinica di metastasi a distanza (M)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/TNMClassificationM"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://irst.emr.it/cvl/P_M_Class"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "http://snomed.info/sct/399387003"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Clinical Metastasis (cM) category in TNM staging, indicating the presence or absence of distant spread based on clinical imaging before surgery."
  } ]
}, {
  "@id" : "http://irst.emr.it/cvl/C_N_Class",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Clinical spread to regional lymph nodes (N)"
  }, {
    "@language" : "it",
    "@value" : "Coinvolgimento clinico dei linfonodi regionali (N)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://irst.emr.it/cvl/TNMClassificationN"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://irst.emr.it/cvl/P_N_Class"
  } ],
